  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font",
        "info": "t:info.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n5",
        "label": "t:labels.heading_font",
        "info": "t:info.heading_font"
      },
      {
        "type": "header",
        "content": "t:labels.font_sizes"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "t:labels.body_size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "t:labels.heading_scale",
        "default": 100,
        "info": "t:info.heading_scale"
      },
      {
        "type": "select",
        "id": "type_heading_weight",
        "label": "t:labels.heading_weight",
        "default": "500",
        "options": [
          { "value": "400", "label": "t:options.font_weight.regular" },
          { "value": "500", "label": "t:options.font_weight.medium" },
          { "value": "600", "label": "t:options.font_weight.semibold" },
          { "value": "700", "label": "t:options.font_weight.bold" }
        ]
      },
      {
        "type": "range",
        "id": "type_letter_spacing",
        "min": -40,
        "max": 20,
        "step": 5,
        "label": "t:labels.heading_letter_spacing",
        "default": -20,
        "info": "t:info.heading_letter_spacing"
      }
    ]
  },
  {
    "name": "t:general.page_loader",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_page_loader",
        "label": "t:labels.enable_page_loader",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_loader_once_per_session",
        "label": "t:labels.page_loader_once_per_session",
        "info": "t:info.page_loader_once_per_session",
        "default": false
      },
      {
        "type": "header",
        "content": "t:labels.page_loader_style_header"
      },
      {
        "type": "select",
        "id": "page_loader_style",
        "label": "t:labels.page_loader_style",
        "default": "cinematic",
        "options": [
          { "value": "cinematic", "label": "t:options.page_loader_style.cinematic" },
          { "value": "light", "label": "t:options.page_loader_style.light" },
          { "value": "brand", "label": "t:options.page_loader_style.brand" }
        ]
      },
      {
        "type": "select",
        "id": "page_loader_exit",
        "label": "t:labels.page_loader_exit",
        "default": "curtain",
        "options": [
          { "value": "curtain", "label": "t:options.page_loader_exit.curtain" },
          { "value": "bloom", "label": "t:options.page_loader_exit.bloom" },
          { "value": "fade", "label": "t:options.page_loader_exit.fade" }
        ]
      },
      {
        "type": "color",
        "id": "page_loader_bg",
        "label": "t:labels.page_loader_bg",
        "info": "t:info.page_loader_colors"
      },
      {
        "type": "color",
        "id": "page_loader_fg",
        "label": "t:labels.page_loader_fg"
      },
      {
        "type": "color",
        "id": "page_loader_muted",
        "label": "t:labels.page_loader_muted"
      },
      {
        "type": "color",
        "id": "page_loader_accent",
        "label": "t:labels.page_loader_accent"
      },
      {
        "type": "header",
        "content": "t:general.content"
      },
      {
        "type": "image_picker",
        "id": "page_loader_image",
        "label": "t:labels.page_loader_image",
        "info": "t:info.page_loader_image"
      },
      {
        "type": "range",
        "id": "page_loader_image_width",
        "min": 64,
        "max": 240,
        "step": 4,
        "unit": "px",
        "label": "t:labels.page_loader_image_width",
        "default": 120
      },
      {
        "type": "text",
        "id": "page_loader_text",
        "label": "t:labels.page_loader_text",
        "info": "t:info.page_loader_text",
        "default": "Welcome"
      },
      {
        "type": "checkbox",
        "id": "page_loader_show_text",
        "label": "t:labels.page_loader_show_text",
        "default": true
      },
      {
        "type": "text",
        "id": "page_loader_caption",
        "label": "t:labels.page_loader_caption",
        "info": "t:info.page_loader_caption",
        "default": "Loading experience"
      },
      {
        "type": "checkbox",
        "id": "page_loader_show_caption",
        "label": "t:labels.page_loader_show_caption",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_loader_show_progress",
        "label": "t:labels.page_loader_show_progress",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_loader_show_percent",
        "label": "t:labels.page_loader_show_percent",
        "default": true
      },
      {
        "type": "header",
        "content": "t:general.behavior"
      },
      {
        "type": "range",
        "id": "page_loader_min_duration",
        "min": 600,
        "max": 2800,
        "step": 100,
        "unit": "ms",
        "label": "t:labels.page_loader_min_duration",
        "default": 1400
      }
    ]
