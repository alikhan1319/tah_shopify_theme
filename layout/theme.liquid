<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% if settings.type_heading_font != blank %}
      {% unless settings.type_heading_font.system? %}
        {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- unless settings.enable_page_loader == false -%}
      <script>
        (function () {
          var once = {{ settings.page_loader_once_per_session | json }};
          try {
            if (once === true && window.sessionStorage.getItem('tah-page-loader-seen') === '1') {
              document.documentElement.classList.add('tah-loader-skip');
              return;
            }
          } catch (e) {}
          document.documentElement.classList.add('is-page-loading');
          try {
            if (once !== true) window.sessionStorage.removeItem('tah-page-loader-seen');
          } catch (e) {}
        })();
      </script>
    {%- endunless -%}
  </head>

  <body>
    {% render 'page-loader' %}
    {% sections 'header-group' %}

    {%- liquid
      assign is_shop_policy = false
      if shop.refund_policy != blank and request.path == shop.refund_policy.url
        assign is_shop_policy = true
      elsif shop.privacy_policy != blank and request.path == shop.privacy_policy.url
        assign is_shop_policy = true
      elsif shop.terms_of_service != blank and request.path == shop.terms_of_service.url
        assign is_shop_policy = true
      elsif shop.shipping_policy != blank and request.path == shop.shipping_policy.url
        assign is_shop_policy = true
      endif
    -%}

    {%- if is_shop_policy -%}
      {% section 'main-policy' %}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}

    {% sections 'footer-group' %}
    {% render 'quick-add-popup' %}
    {% render 'wishlist' %}
    {% render 'back-to-top' %}
    {% render 'theme-reveal' %}
  </body>
</html>
