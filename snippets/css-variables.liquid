{% doc %}
  Outputs global theme CSS variables for colors and typography.
  Controlled from Theme settings → Colors / Typography.
{% enddoc %}

{% style %}
  {%- liquid
    assign body_font = settings.type_primary_font
    assign heading_font = settings.type_heading_font
    if heading_font == blank
      assign heading_font = body_font
    endif

    assign heading_spacing = settings.type_letter_spacing | default: -20 | times: 0.001
    assign heading_scale = settings.type_heading_scale | default: 100 | divided_by: 100.0
  -%}

  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ heading_font | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ heading_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}

  :root {
    /* Typography */
    --font-primary--family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-primary--style: {{ body_font.style }};
    --font-primary--weight: {{ body_font.weight }};
    --font-heading--family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading--style: {{ heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_weight | default: heading_font.weight }};
    --font-body-size: {{ settings.type_body_size | default: 16 }}px;
    --font-heading-scale: {{ heading_scale }};
    --font-heading-letter-spacing: {{ heading_spacing }}em;

    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Brand colors */
    --color-background: {{ settings.color_background | default: settings.background_color | default: '#FFFFFF' }};
    --color-surface: {{ settings.color_surface | default: '#FBF3F8' }};
    --color-foreground: {{ settings.color_text | default: settings.foreground_color | default: '#6B2A5C' }};
    --color-text: var(--color-foreground);
    --color-text-muted: {{ settings.color_text_muted | default: '#B07A9E' }};
    --color-heading: {{ settings.color_heading | default: '#5E184F' }};
    --color-border: {{ settings.color_border | default: '#F1D5E6' }};

    /* Accent / interaction */
    --color-accent: {{ settings.color_accent | default: '#A0338E' }};
    --color-hover: {{ settings.color_hover | default: '#7C2470' }};
    --color-sale: {{ settings.color_sale | default: '#C41E7A' }};
    --color-wave: {{ settings.color_wave | default: '#A0338E' }};
    --color-star: {{ settings.color_star | default: '#C9A227' }};
    --color-success: {{ settings.color_success | default: '#15803D' }};
    --color-error: {{ settings.color_error | default: '#B42318' }};

    /* Buttons */
    --color-button: {{ settings.color_button | default: '#A0338E' }};
    --color-button-text: {{ settings.color_button_text | default: '#FFFFFF' }};
    --color-button-hover: {{ settings.color_button_hover | default: '#7C2470' }};
    --button-radius: {{ settings.button_corner_radius | default: 40 }}px;

    /* Header */
    --color-header-background: {{ settings.color_header_background | default: '#FDF8FB' }};
    --color-header-text: {{ settings.color_header_text | default: '#5E184F' }};

    /* Announcement bar */
    --color-announcement-background: {{ settings.color_announcement_background | default: '#A0338E' }};
    --color-announcement-text: {{ settings.color_announcement_text | default: '#FFFFFF' }};
    --color-announcement-link: {{ settings.color_announcement_link | default: '#FFFFFF' }};

    /* Links */
    --color-link: {{ settings.color_link | default: '#A0338E' }};
    --color-link-hover: {{ settings.color_link_hover | default: '#7C2470' }};

    /* Forms */
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;

    /* Shared aliases used across sections */
    --color-ink: var(--color-heading);
    --color-mute: var(--color-text-muted);
    --color-line: var(--color-border);
  }
{% endstyle %}
