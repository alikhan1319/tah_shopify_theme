{% doc %}
  Floating button that appears after scrolling and smoothly returns to the top.

  @example
  {% render 'back-to-top' %}
{% enddoc %}

<back-to-top class="back-to-top" hidden>
  <button
    type="button"
    class="back-to-top__btn"
    data-back-to-top
    aria-label="{{ 'accessibility.back_to_top' | t }}"
  >
    <svg class="back-to-top__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</back-to-top>

{% stylesheet %}
  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 80;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 220ms;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top.is-visible[hidden] {
    display: block;
  }

  .back-to-top__btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-button);
    color: var(--color-button-text);
    cursor: pointer;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--color-heading) 22%, transparent);
    transition:
      background-color 180ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 180ms ease;
  }

  .back-to-top__btn:hover,
  .back-to-top__btn:focus-visible {
    background: var(--color-button-hover);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--color-heading) 28%, transparent);
  }

  .back-to-top__icon {
    display: block;
  }

  body.quick-add-open .back-to-top {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (min-width: 750px) {
    .back-to-top {
      right: max(1.5rem, env(safe-area-inset-right));
      bottom: max(1.5rem, env(safe-area-inset-bottom));
    }

    .back-to-top__btn {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top__btn {
      transition: none;
    }

    .back-to-top__btn:hover,
    .back-to-top__btn:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class BackToTop extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      this.button = this.querySelector('[data-back-to-top]');
      this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.threshold = 420;

      this.onScroll = () => {
        window.clearTimeout(this._scrollTimer);
        this._scrollTimer = window.setTimeout(() => this.syncVisibility(), 40);
      };

      this.onClick = (event) => {
        event.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: this.reduceMotion ? 'auto' : 'smooth',
        });
      };

      this.button?.addEventListener('click', this.onClick);
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.hidden = false;
      this.syncVisibility();
    }

    disconnectedCallback() {
      this.button?.removeEventListener('click', this.onClick);
      window.removeEventListener('scroll', this.onScroll);
      window.clearTimeout(this._scrollTimer);
    }

    syncVisibility() {
      const show = window.scrollY > this.threshold;
      this.classList.toggle('is-visible', show);
    }
  }

  if (!customElements.get('back-to-top')) {
    customElements.define('back-to-top', BackToTop);
  }
{% endjavascript %}
