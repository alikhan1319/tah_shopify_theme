{% doc %}
  Renders a social network SVG icon.

  @param {string} network - Social network handle (facebook, instagram, x, twitter, tiktok, pinterest, youtube, linkedin)
  @param {string} [class] - Optional CSS class on the SVG

  @example
  {% render 'icon-social', network: 'instagram', class: 'announcement-bar__social-icon' %}
{% enddoc %}

{% liquid
  assign network_handle = network | strip | downcase
  if network_handle == 'twitter'
    assign network_handle = 'x'
  endif
%}

<svg
  class="{{ class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  width="16"
  height="16"
>
  {%- case network_handle -%}
    {%- when 'facebook' -%}
      <path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1Z"/>
    {%- when 'instagram' -%}
      <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2A3.2 3.2 0 1 1 12 8.8a3.2 3.2 0 0 1 0 6.4Z"/>
      <path d="M17.5 2h-11A4.5 4.5 0 0 0 2 6.5v11A4.5 4.5 0 0 0 6.5 22h11a4.5 4.5 0 0 0 4.5-4.5v-11A4.5 4.5 0 0 0 17.5 2Zm2.7 15.5a2.7 2.7 0 0 1-2.7 2.7h-11a2.7 2.7 0 0 1-2.7-2.7v-11a2.7 2.7 0 0 1 2.7-2.7h11a2.7 2.7 0 0 1 2.7 2.7v11Z"/>
      <circle cx="17.5" cy="6.5" r="1.2"/>
    {%- when 'x' -%}
      <path d="M18.9 3H21l-6.6 7.5L22 21h-5.6l-4.4-5.7L7 21H4.9l7-8L2.8 3H8.5l4 5.2L18.9 3Zm-2 16.2h1.6L7.2 4.7H5.5l11.4 14.5Z"/>
    {%- when 'tiktok' -%}
      <path d="M19.6 8.3a6.7 6.7 0 0 1-3.9-1.2v7.1a5.7 5.7 0 1 1-5.7-5.7c.3 0 .6 0 .9.1v2.8a2.9 2.9 0 1 0 2 2.8V2.8h2.8a3.9 3.9 0 0 0 3.9 3.9v1.6Z"/>
    {%- when 'pinterest' -%}
      <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2.1 0-3l1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.6 1.9 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3.1 0-5 2.3-5 4.8 0 .9.3 1.5.7 2 .1.1.1.2.1.3l-.3 1c0 .2-.2.2-.4.1-1.4-.6-2.1-2.2-2.1-4 0-3 2.5-6.6 7.5-6.6 4 0 6.6 2.9 6.6 6 0 4.1-2.3 7.1-5.6 7.1-1.1 0-2.2-.6-2.5-1.3l-.7 2.6c-.2.9-.8 1.9-1.3 2.6A10 10 0 1 0 12 2Z"/>
    {%- when 'youtube' -%}
      <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 5 12 5 12 5s-6 0-7.7.3A2.7 2.7 0 0 0 2.4 7.2 28.4 28.4 0 0 0 2 12a28.4 28.4 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9C6 19 12 19 12 19s6 0 7.7-.3a2.7 2.7 0 0 0 1.9-1.9A28.4 28.4 0 0 0 22 12a28.4 28.4 0 0 0-.4-4.8ZM10 15.2V8.8L15.5 12 10 15.2Z"/>
    {%- when 'linkedin' -%}
      <path d="M6.5 9.5H3.7V20h2.8V9.5ZM5.1 4A1.6 1.6 0 1 0 5.1 7.2 1.6 1.6 0 0 0 5.1 4ZM20.3 20h-2.8v-5.6c0-1.5-.5-2.5-1.8-2.5-1 0-1.5.7-1.8 1.3-.1.2-.1.5-.1.8V20h-2.8s0-9.4 0-10.5h2.8v1.5c.4-.6 1.1-1.7 2.8-1.7 2 0 3.5 1.3 3.5 4.2V20Z"/>
  {%- endcase -%}
</svg>
