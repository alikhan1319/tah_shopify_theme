{% doc %}
  Renders one catalog collection tile.

  @param {string} title - Category title
  @param {string} [url] - Link URL
  @param {image} [image] - Category image
  @param {string} slot - Mosaic slot class suffix
  @param {string} [count_label] - Optional product count label
  @param {object} [block] - Optional theme block for editor attributes
  @param {string} [style] - overlay (default) or feature
  @param {number} [icon_index] - Icon variant for feature cards

  @example
  {% render 'catalog-tile', title: 'Latest', url: '#', slot: 'tall_left' %}
{% enddoc %}

{%- liquid
  assign tile_style = style | default: 'overlay'
  assign icon_mod = icon_index | default: 1 | modulo: 4
-%}

{%- if tile_style == 'feature' -%}
  <a
    class="catalog__feature catalog__feature--{{ icon_mod }}"
    href="{{ url | default: '#' }}"
    role="listitem"
    {% if block %}{{ block.shopify_attributes }}{% endif %}
  >
    <span class="catalog__feature-photo">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '320,480,720,900',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 40vw, 80vw',
            class: 'catalog__feature-image',
            alt: title
        }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'catalog__feature-placeholder' }}
      {%- endif -%}
    </span>

    <span class="catalog__feature-copy">
      <span class="catalog__feature-icon" aria-hidden="true">
        {%- case icon_mod -%}
          {%- when 1 -%}
            <svg viewBox="0 0 24 24" fill="none"><path d="M6 7.5h12l.8 12.2a1.5 1.5 0 0 1-1.5 1.6H6.7a1.5 1.5 0 0 1-1.5-1.6L6 7.5Z" stroke="currentColor" stroke-width="1.6"/><path d="M9 7.5V6.2A3 3 0 0 1 12 3.2 3 3 0 0 1 15 6.2v1.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          {%- when 2 -%}
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 15.5h11.5L18 8H8.2L4 15.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 19.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Zm9.2 0a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z" stroke="currentColor" stroke-width="1.6"/></svg>
          {%- when 3 -%}
            <svg viewBox="0 0 24 24" fill="none"><path d="M6.5 9.5h11l.8 9.2a1.6 1.6 0 0 1-1.6 1.8H7.3a1.6 1.6 0 0 1-1.6-1.8l.8-9.2Z" stroke="currentColor" stroke-width="1.6"/><path d="M9 9.5V8a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5 13.2 8H18l-3.9 2.8L15.4 16 12 13.3 8.6 16l1.3-5.2L6 8h4.8L12 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        {%- endcase -%}
      </span>

      {%- if title != blank -%}
        <span class="catalog__feature-title">{{ title | escape }}</span>
      {%- endif -%}

      <span class="catalog__feature-cta">
        {{ 'collections.explore_now' | t }}
        <span aria-hidden="true">→</span>
      </span>
    </span>
  </a>
{%- else -%}
  <a
    class="catalog__tile catalog__tile--{{ slot }}"
    href="{{ url | default: '#' }}"
    role="listitem"
    {% if block %}{{ block.shopify_attributes }}{% endif %}
  >
    <div class="catalog__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '480,720,960,1200,1600',
            sizes: '(min-width: 990px) 35vw, (min-width: 750px) 50vw, 100vw',
            class: 'catalog__image',
            alt: title
        }}
      {%- else -%}
        <div class="catalog__placeholder" aria-hidden="true">
          {{ 'collection-1' | placeholder_svg_tag: 'catalog__placeholder-svg' }}
        </div>
      {%- endif -%}
      <span class="catalog__veil" aria-hidden="true"></span>
    </div>

    <span class="catalog__content">
      {%- if count_label != blank -%}
        <span class="catalog__meta">{{ count_label | escape }}</span>
      {%- endif -%}
      {%- if title != blank -%}
        <span class="catalog__title">{{ title | escape }}</span>
      {%- endif -%}
      <span class="catalog__cta">
        {{ 'collections.shop_now' | t }}
        <span class="catalog__cta-icon" aria-hidden="true">→</span>
      </span>
    </span>
  </a>
{%- endif -%}
