{% doc %}
  Renders one catalog collection tile with image, overlay, and shop cue.

  @param {string} title - Category title
  @param {string} [url] - Link URL
  @param {image} [image] - Category image
  @param {string} slot - Mosaic slot class suffix
  @param {string} [count_label] - Optional product count label
  @param {object} [block] - Optional theme block for editor attributes

  @example
  {% render 'catalog-tile', title: 'Latest', url: '#', slot: 'tall_left' %}
{% enddoc %}

<a
  class="catalog__tile catalog__tile--{{ slot }}"
  href="{{ url | default: '#' }}"
  role="listitem"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  <div class="catalog__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '480,720,960,1200,1600',
          sizes: '(min-width: 990px) 35vw, (min-width: 750px) 50vw, 100vw',
          class: 'catalog__image',
          alt: title
      }}
    {%- else -%}
      <div class="catalog__placeholder" aria-hidden="true">
        {{ 'collection-1' | placeholder_svg_tag: 'catalog__placeholder-svg' }}
      </div>
    {%- endif -%}
    <span class="catalog__veil" aria-hidden="true"></span>
  </div>

  <span class="catalog__content">
    {%- if count_label != blank -%}
      <span class="catalog__meta">{{ count_label | escape }}</span>
    {%- endif -%}
    {%- if title != blank -%}
      <span class="catalog__title">{{ title | escape }}</span>
    {%- endif -%}
    <span class="catalog__cta">
      {{ 'collections.shop_now' | t }}
      <span class="catalog__cta-icon" aria-hidden="true">→</span>
    </span>
  </span>
</a>
