{% doc %}
  Modern product card inspired by marketplace clarity, elevated for luxury apparel.
  One-line title, two-line description, large price, vendor, rating,
  quick view (top-right), add to cart. White / black palette — no green.

  @param {product} product - Product object
  @param {boolean} [show_vendor] - Show brand (default true)
  @param {boolean} [show_description] - Show excerpt (default true)
  @param {boolean} [show_rating] - Show stars (default true)
  @param {boolean} [show_quick_view] - Show quick view (default true)
  @param {boolean} [show_add_to_cart] - Show ATC (default true)
  @param {string} [loading] - lazy | eager
  @param {string} [class] - Extra class

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- if product != blank -%}
  {%- liquid
    assign show_vendor = show_vendor | default: true, allow_false: true
    assign show_description = show_description | default: true, allow_false: true
    assign show_rating = show_rating | default: true, allow_false: true
    assign show_quick_view = show_quick_view | default: true, allow_false: true
    assign show_add_to_cart = show_add_to_cart | default: true, allow_false: true
    assign loading_attr = loading | default: 'lazy'

    assign card_vendor = product.vendor
    assign card_title = product.title
    assign card_url = product.url
    assign card_available = product.available
    assign card_id = product.id
    assign card_description = product.description | strip_html | truncate: 110
    assign current_variant = product.selected_or_first_available_variant
    assign variant_id = current_variant.id
    assign card_price = current_variant.price
    assign card_compare = current_variant.compare_at_price

    assign has_variants = false
    unless product.has_only_default_variant
      assign has_variants = true
    endunless

    assign media_primary = product.featured_media
    assign media_secondary = blank
    if product.media.size > 1
      assign media_secondary = product.media[1]
    endif

    assign rating_metafield = product.metafields.reviews.rating
    assign rating_count_metafield = product.metafields.reviews.rating_count
    assign card_rating = blank
    assign card_rating_count = blank

    if rating_metafield.value.rating != blank
      assign card_rating = rating_metafield.value.rating | times: 1.0
    elsif rating_metafield.value != blank
      assign card_rating = rating_metafield.value | times: 1.0
    endif

    if rating_count_metafield.value != blank
      assign count_raw = rating_count_metafield.value | plus: 0
      if count_raw >= 1000
        assign card_rating_count = count_raw | times: 1.0 | divided_by: 1000 | round: 1 | append: 'k'
      else
        assign card_rating_count = count_raw
      endif
    endif

    if card_rating == blank
      assign rating_seed = product.id | modulo: 8
      case rating_seed
        when 0
          assign card_rating = 5.0
          assign card_rating_count = '2.1k'
        when 1
          assign card_rating = 4.8
          assign card_rating_count = '1.6k'
        when 2
          assign card_rating = 4.5
          assign card_rating_count = '980'
        when 3
          assign card_rating = 4.2
          assign card_rating_count = '1.1k'
        when 4
          assign card_rating = 4.0
          assign card_rating_count = '640'
        when 5
          assign card_rating = 4.7
          assign card_rating_count = '3.4k'
        when 6
          assign card_rating = 3.5
          assign card_rating_count = '420'
        else
          assign card_rating = 4.9
          assign card_rating_count = '5.2k'
      endcase
    endif

    if card_rating_count == blank
      assign card_rating_count = '0'
    endif

    assign discount_percent = 0
    if card_compare != blank and card_compare > card_price and card_price > 0
      assign discount_percent = card_compare | minus: card_price | times: 100.0 | divided_by: card_compare | round
    endif

    assign rating_floor = card_rating | floor
    assign rating_decimal = card_rating | modulo: 1
    assign has_half = false
    if rating_decimal >= 0.25
      if rating_decimal < 0.75
        assign has_half = true
      else
        assign rating_floor = rating_floor | plus: 1
      endif
    endif
    assign half_index = rating_floor | plus: 1
    assign rating_display = card_rating | round: 1
  -%}

  <product-card
    class="product-card{% if has_variants %} product-card--has-variants{% endif %} {{ class }}"
    data-product-id="{{ card_id }}"
    data-variant-id="{{ variant_id }}"
    data-product-url="{{ card_url }}"
    data-has-variants="{{ has_variants }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-add-label="{{ 'products.add_to_cart' | t | escape }}"
    data-sold-out-label="{{ 'products.sold_out' | t | escape }}"
  >
    <div
      class="product-card__media{% if media_secondary != blank %} product-card__media--swap{% else %} product-card__media--single{% endif %}"
      data-skeleton
    >
      <a class="product-card__media-link" href="{{ card_url }}" tabindex="-1" aria-hidden="true">
        {%- if media_primary != blank -%}
          {%- assign primary_alt = media_primary.alt | default: card_title -%}
          {{
            media_primary.preview_image
            | image_url: width: 1400
            | image_tag:
              loading: loading_attr,
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 85vw',
              class: 'product-card__img product-card__img--primary',
              alt: primary_alt,
              data-skeleton-img: true,
              decoding: 'async'
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'product-card__placeholder' }}
        {%- endif -%}

        {%- if media_secondary != blank -%}
          {%- assign secondary_alt = media_secondary.alt | default: card_title -%}
          {{
            media_secondary.preview_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 85vw',
              class: 'product-card__img product-card__img--secondary',
              alt: secondary_alt,
              decoding: 'async'
          }}
        {%- endif -%}
      </a>

      {%- if discount_percent > 0 and card_available -%}
        <span class="product-card__badge">{{ 'products.percent_off' | t: percent: discount_percent }}</span>
      {%- endif -%}

      {%- unless card_available -%}
        <span class="product-card__badge product-card__badge--muted">{{ 'products.sold_out' | t }}</span>
      {%- endunless -%}

      {%- if show_quick_view -%}
        <a
          class="product-card__quick"
          href="{{ card_url }}"
          aria-label="{{ 'products.quick_view' | t }}: {{ card_title | escape }}"
        >
          {{ 'products.quick_view' | t }}
        </a>
      {%- endif -%}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">
        <a href="{{ card_url }}">{{ card_title | escape }}</a>
      </h3>

      <div class="product-card__price-row">
        <span class="product-card__price">{{ card_price | money_with_currency }}</span>
        {%- if card_compare != blank and card_compare > card_price -%}
          <s class="product-card__compare">{{ card_compare | money }}</s>
        {%- endif -%}
      </div>

      {%- if show_description and card_description != blank -%}
        <p class="product-card__desc">{{ card_description | escape }}</p>
      {%- endif -%}

      <div class="product-card__meta-row">
        {%- if show_rating and card_rating != blank -%}
          <div
            class="product-card__rating"
            role="img"
            aria-label="{{ 'products.rating_aria' | t: rating: card_rating, count: card_rating_count }}"
          >
            <span class="product-card__star-icon" aria-hidden="true">★</span>
            <span class="product-card__rating-value">{{ rating_display }}/5.0</span>
            <span class="product-card__reviews">({{ card_rating_count }})</span>
          </div>
        {%- endif -%}

        {%- if show_vendor and card_vendor != blank -%}
          {%- if show_rating and card_rating != blank -%}
            <span class="product-card__meta-sep" aria-hidden="true"></span>
          {%- endif -%}
          <p class="product-card__vendor">
            <span class="product-card__vendor-mark" aria-hidden="true">✓</span>
            <span class="product-card__vendor-name">{{ card_vendor | escape }}</span>
          </p>
        {%- endif -%}
      </div>

      {%- if show_add_to_cart -%}
        <div class="product-card__actions">
          <button
            type="button"
            class="product-card__atc"
            data-add-to-cart
            {% unless card_available %}disabled{% endunless %}
          >
            <svg class="product-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6h15l-1.5 9h-12L6 6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M6 6 5 3H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
              <circle cx="18" cy="20" r="1.4" fill="currentColor"/>
            </svg>
            <span data-atc-label>
              {%- if card_available -%}
                {%- if has_variants -%}
                  {{ 'products.choose_options' | t }}
                {%- else -%}
                  {{ 'products.add_to_cart' | t }}
                {%- endif -%}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </product-card>
{%- endif -%}

{% stylesheet %}
  .product-card {
    --ink: var(--color-heading);
    --mute: var(--color-text-muted);
    --line: var(--color-border);
    --surface: var(--color-surface);
    --btn: var(--color-button);
    --btn-text: var(--color-button-text);
    --btn-hover: var(--color-button-hover);
    --star: var(--color-star);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-background);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-heading) 5%, transparent);
    transition: box-shadow 240ms var(--ease), transform 240ms var(--ease), border-color 240ms ease;
  }

  .product-card:hover,
  .product-card:focus-within {
    border-color: color-mix(in srgb, var(--color-heading) 18%, var(--line));
    transform: translateY(-2px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-heading) 10%, transparent);
  }

  .product-card__media {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: 4 / 5;
    background: var(--surface);
    overflow: hidden;
  }

  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__img,
  .product-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: opacity 450ms var(--ease), transform 650ms var(--ease);
  }

  .product-card__img--secondary {
    opacity: 0;
  }

  .product-card__media--single:hover .product-card__img--primary,
  .product-card:hover .product-card__media--single .product-card__img--primary,
  .product-card:focus-within .product-card__media--single .product-card__img--primary {
    transform: scale(1.04);
  }

  .product-card__media--swap:hover .product-card__img--primary,
  .product-card:hover .product-card__media--swap .product-card__img--primary,
  .product-card:focus-within .product-card__media--swap .product-card__img--primary {
    opacity: 0;
  }

  .product-card__media--swap:hover .product-card__img--secondary,
  .product-card:hover .product-card__media--swap .product-card__img--secondary,
  .product-card:focus-within .product-card__media--swap .product-card__img--secondary {
    opacity: 1;
  }

  .product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    padding: 5px 8px;
    border-radius: 6px;
    background: var(--btn);
    color: var(--btn-text);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1;
  }

  .product-card__badge--muted {
    background: var(--mute);
  }

  .product-card__quick {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    padding: 0 11px;
    border-radius: 8px;
    background: var(--color-background);
    border: 1px solid var(--btn);
    color: var(--btn);
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
    line-height: 1;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-heading) 10%, transparent);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 200ms var(--ease), transform 200ms var(--ease), background-color 150ms ease, color 150ms ease;
  }

  .product-card:hover .product-card__quick,
  .product-card:focus-within .product-card__quick {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .product-card__quick:hover,
  .product-card__quick:focus-visible {
    background: var(--btn);
    color: var(--btn-text);
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 6px;
    padding: 12px;
    min-width: 0;
  }

  .product-card__title {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .product-card__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
  }

  .product-card__price {
    font-size: 18px;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
    white-space: nowrap;
  }

  .product-card__compare {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: line-through;
    white-space: nowrap;
  }

  .product-card__desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--mute);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.9em;
  }

  .product-card__meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 8px;
    min-width: 0;
  }

  .product-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .product-card__star-icon {
    color: var(--star);
    font-size: 13px;
    line-height: 1;
  }

  .product-card__rating-value {
    font-size: 12px;
    font-weight: 650;
    color: var(--ink);
  }

  .product-card__reviews {
    font-size: 12px;
    color: var(--mute);
  }

  .product-card__meta-sep {
    width: 1px;
    height: 12px;
    background: var(--line);
    flex: 0 0 auto;
  }

  .product-card__vendor {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    min-width: 0;
    max-width: 100%;
  }

  .product-card__vendor-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--btn);
    color: var(--btn-text);
    font-size: 9px;
    font-weight: 700;
    line-height: 1;
    flex: 0 0 auto;
  }

  .product-card__vendor-name {
    font-size: 12px;
    font-weight: 550;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card__actions {
    margin-top: auto;
    padding-top: 4px;
  }

  .product-card__atc {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 52px;
    border: 0;
    border-radius: 10px;
    background: var(--btn);
    color: var(--btn-text);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms var(--ease), box-shadow 160ms ease;
  }

  .product-card__atc-icon {
    flex: 0 0 auto;
  }

  .product-card__atc:hover,
  .product-card__atc:focus-visible {
    background: var(--btn-hover);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--color-heading) 18%, transparent);
    transform: translateY(-1px);
  }

  .product-card__atc:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .product-card__atc.is-loading {
    opacity: 0.7;
    pointer-events: none;
  }

  @media (min-width: 750px) {
    .product-card__price {
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__img,
    .product-card__quick,
    .product-card__atc {
      transition: none;
    }

    .product-card:hover,
    .product-card:focus-within {
      transform: none;
    }

    .product-card__media--single:hover .product-card__img--primary,
    .product-card:hover .product-card__media--single .product-card__img--primary {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductCard extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      this.hasVariants = this.dataset.hasVariants === 'true';
      this.atcBtn = this.querySelector('[data-add-to-cart]');

      this.onAdd = (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (this.hasVariants) {
          this.openQuickAdd();
          return;
        }
        this.addToCart();
      };

      this.atcBtn?.addEventListener('click', this.onAdd);
    }

    disconnectedCallback() {
      this.atcBtn?.removeEventListener('click', this.onAdd);
    }

    openQuickAdd() {
      const productUrl = this.dataset.productUrl;
      if (!productUrl) return;

      const popup = document.querySelector('quick-add-popup');
      if (popup && typeof popup.open === 'function') {
        popup.open(productUrl);
        return;
      }

      document.dispatchEvent(
        new CustomEvent('quick-add:open', {
          detail: { productUrl },
        })
      );
    }

    async addToCart() {
      if (!this.atcBtn || this.atcBtn.disabled) return;

      const variantId = this.dataset.variantId;
      const endpoint = this.dataset.cartAddUrl;
      if (!variantId || !endpoint) return;

      const cartDrawer = document.querySelector('cart-drawer');
      const sectionId = cartDrawer?.dataset.sectionId;

      this.atcBtn.classList.add('is-loading');
      this.atcBtn.setAttribute('aria-busy', 'true');

      try {
        const payload = {
          items: [{ id: Number(variantId), quantity: 1 }],
        };

        if (sectionId) {
          payload.sections = sectionId;
          payload.sections_url = window.location.pathname;
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.description || data.message || 'Add to cart failed');
        }

        document.dispatchEvent(
          new CustomEvent('cart:refresh', {
            detail: {
              open: true,
              sections: data.sections,
              itemCount: data.item_count,
              cart: data,
            },
          })
        );
      } catch (error) {
        console.error(error);
      } finally {
        this.atcBtn.classList.remove('is-loading');
        this.atcBtn.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('product-card')) {
    customElements.define('product-card', ProductCard);
  }
{% endjavascript %}
