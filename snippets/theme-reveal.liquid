{% doc %}
  Global skeleton shimmer and scroll-reveal helpers.
  - `[data-skeleton]` hosts show a shimmer until an inner image/video fires load/canplay
  - `[data-reveal]` elements fade/slide in when scrolled into view

  @example
  {% render 'theme-reveal' %}
{% enddoc %}

{% stylesheet %}
  @keyframes tah-skeleton-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  [data-skeleton] {
    position: relative;
    isolation: isolate;
  }

  [data-skeleton]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(
      110deg,
      var(--color-surface, #f2f2f2) 0%,
      var(--color-surface, #f2f2f2) 35%,
      color-mix(in srgb, var(--color-background, #fff) 85%, var(--color-border, #e6e6e6)) 50%,
      var(--color-surface, #f2f2f2) 65%,
      var(--color-surface, #f2f2f2) 100%
    );
    background-size: 220% 100%;
    animation: tah-skeleton-shimmer 1.15s ease-in-out infinite;
    transition: opacity 280ms ease, visibility 280ms ease;
  }

  [data-skeleton].is-loaded::before,
  [data-skeleton][data-skeleton-ready]::before {
    opacity: 0;
    visibility: hidden;
    animation: none;
  }

  [data-skeleton] > img,
  [data-skeleton] img[data-skeleton-img],
  [data-skeleton] video,
  [data-skeleton] iframe {
    opacity: 0;
    transition: opacity 320ms ease;
  }

  [data-skeleton].is-loaded > img,
  [data-skeleton].is-loaded img[data-skeleton-img],
  [data-skeleton].is-loaded video,
  [data-skeleton].is-loaded iframe,
  [data-skeleton][data-skeleton-ready] > img,
  [data-skeleton][data-skeleton-ready] img[data-skeleton-img],
  [data-skeleton][data-skeleton-ready] video,
  [data-skeleton][data-skeleton-ready] iframe {
    opacity: 1;
  }

  /* Product card: keep secondary hidden until hover even after load */
  .product-card__media.is-loaded .product-card__img--secondary,
  .product-card__media[data-skeleton-ready] .product-card__img--secondary {
    opacity: 0;
  }

  .product-card__media--swap.is-loaded:hover .product-card__img--secondary,
  .product-card:hover .product-card__media--swap.is-loaded .product-card__img--secondary,
  .product-card:focus-within .product-card__media--swap.is-loaded .product-card__img--secondary,
  .product-card__media--swap[data-skeleton-ready]:hover .product-card__img--secondary,
  .product-card:hover .product-card__media--swap[data-skeleton-ready] .product-card__img--secondary,
  .product-card:focus-within .product-card__media--swap[data-skeleton-ready] .product-card__img--secondary {
    opacity: 1;
  }

  .product-card__media--swap.is-loaded:hover .product-card__img--primary,
  .product-card:hover .product-card__media--swap.is-loaded .product-card__img--primary,
  .product-card:focus-within .product-card__media--swap.is-loaded .product-card__img--primary,
  .product-card__media--swap[data-skeleton-ready]:hover .product-card__img--primary,
  .product-card:hover .product-card__media--swap[data-skeleton-ready] .product-card__img--primary,
  .product-card:focus-within .product-card__media--swap[data-skeleton-ready] .product-card__img--primary {
    opacity: 0;
  }

  /* Scroll reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
    will-change: auto;
  }

  [data-reveal-stagger] > [data-reveal] {
    transition-delay: calc(var(--reveal-index, 0) * 55ms);
  }

  @media (scripting: none) {
    [data-skeleton]::before {
      display: none;
    }

    [data-skeleton] > img,
    [data-skeleton] img[data-skeleton-img],
    [data-skeleton] video,
    [data-skeleton] iframe,
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-skeleton]::before {
      animation: none;
    }

    [data-skeleton] > img,
    [data-skeleton] img[data-skeleton-img],
    [data-skeleton] video,
    [data-skeleton] iframe,
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    [data-skeleton]::before {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function markLoaded(host) {
      if (!host || host.classList.contains('is-loaded')) return;
      host.classList.add('is-loaded');
      host.setAttribute('data-skeleton-ready', '');
    }

    function bindSkeleton(host) {
      if (!host || host.dataset.skeletonBound === '1') return;
      host.dataset.skeletonBound = '1';

      if (reduceMotion) {
        markLoaded(host);
        return;
      }

      const media =
        host.querySelector('[data-skeleton-img]') ||
        host.querySelector('img') ||
        host.querySelector('video') ||
        host.querySelector('iframe');

      if (!media) {
        markLoaded(host);
        return;
      }

      const done = () => markLoaded(host);

      if (media.tagName === 'IMG') {
        if (media.complete && media.naturalWidth > 0) {
          done();
          return;
        }
        media.addEventListener('load', done, { once: true });
        media.addEventListener('error', done, { once: true });
      } else if (media.tagName === 'VIDEO') {
        if (media.readyState >= 2) {
          done();
          return;
        }
        media.addEventListener('loadeddata', done, { once: true });
        media.addEventListener('error', done, { once: true });
      } else {
        media.addEventListener('load', done, { once: true });
        media.addEventListener('error', done, { once: true });
      }

      // Safety timeout so skeleton never sticks forever
      window.setTimeout(done, 6000);
    }

    function initSkeletons(root) {
      (root || document).querySelectorAll('[data-skeleton]').forEach(bindSkeleton);
    }

    function initReveal(root) {
      const scope = root || document;
      const items = scope.querySelectorAll('[data-reveal]:not(.is-visible)');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          root: null,
          rootMargin: '40px 0px -4% 0px',
          threshold: 0.08,
        }
      );

      items.forEach((el, index) => {
        const parent = el.closest('[data-reveal-stagger]');
        if (parent) {
          const siblings = parent.querySelectorAll('[data-reveal]');
          const i = Array.prototype.indexOf.call(siblings, el);
          el.style.setProperty('--reveal-index', String(i >= 0 ? i : index));
        }
        observer.observe(el);
      });

      // Failsafe: never leave content permanently hidden
      window.setTimeout(() => {
        items.forEach((el) => {
          if (!el.classList.contains('is-visible')) {
            el.classList.add('is-visible');
            observer.unobserve(el);
          }
        });
      }, 2800);
    }

    function boot(root) {
      initSkeletons(root);
      initReveal(root);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => boot(document), { once: true });
    } else {
      boot(document);
    }

    // Re-bind after Shopify section reloads / AJAX injections
    document.addEventListener('shopify:section:load', (event) => {
      boot(event.target);
    });

    window.TahReveal = { boot, initSkeletons, initReveal, markLoaded };
  })();
{% endjavascript %}
