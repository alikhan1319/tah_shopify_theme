{% doc %}
  Modern About page layout for Star Fabrics.
  Used by the about section and as a fallback on about page handles.

  @param {object} [section] - Optional section object for settings/blocks/attributes
  @param {string} [page_title] - Fallback title from the page object

  @example
  {% render 'about-page', section: section, page_title: page.title %}
{% enddoc %}

{%- liquid
  assign s = section.settings

  assign eyebrow = s.eyebrow | default: 'Our story'
  assign heading = s.heading | default: page_title | default: 'About Star Fabrics'
  if heading == blank
    assign heading = 'About Star Fabrics'
  endif
  assign subheading = s.subheading

  assign story_eyebrow = s.story_eyebrow | default: 'Star Fabrics'
  assign story_heading = s.story_heading | default: 'Premium fabrics. Timeless style.'
  assign story_text = s.story_text
  if story_text == blank
    capture story_text
      echo '<p>Star Fabrics is a trusted clothing brand committed to delivering quality, style, and comfort. We specialize in providing premium fabrics and fashionable designs that reflect modern trends while maintaining timeless elegance. Our focus on quality materials and fine craftsmanship ensures that every product meets the expectations of our valued customers.</p><p>With a passion for fashion and a dedication to excellence, Star Fabrics continues to grow as a reliable name in the clothing industry.</p>'
    endcapture
  endif

  assign mission_heading = s.mission_heading | default: 'Our mission'
  assign mission_text = s.mission_text | default: 'Our mission is to provide high-quality clothing that combines comfort, durability, and contemporary style. We aim to build long-lasting relationships with our customers by offering exceptional value and consistent quality.'

  assign vision_heading = s.vision_heading | default: 'Our vision'
  assign vision_text = s.vision_text | default: 'Our vision is to become a leading name in the fashion industry, recognized for innovation, trust, and excellence. We aspire to set new standards in clothing by continuously evolving with trends while staying true to our core values.'

  assign ceo_heading = s.ceo_heading | default: "CEO's message"
  assign ceo_name = s.ceo_name | default: 'CEO, Star Fabrics'
  assign ceo_role = s.ceo_role | default: 'CEO'
  assign ceo_text = s.ceo_text | default: 'As the CEO of Star Fabrics, I am proud to lead a brand that stands for quality, integrity, and customer satisfaction. From fabric selection to final design, every step is guided by our commitment to excellence. Fashion is a reflection of confidence and individuality, and our goal is to deliver clothing that makes our customers feel comfortable, stylish, and confident. Thank you for trusting Star Fabrics and being part of our journey.'
  assign ceo_image = s.ceo_image
  assign ceo_image_alt = s.ceo_image_alt | default: ceo_name

  assign image_position = s.image_position | default: 'left'
  assign header_alignment = s.header_alignment | default: 'left'
  assign pad_top = s.padding_top | default: 64
  assign pad_bottom = s.padding_bottom | default: 88
  assign use_theme_colors = true
  if s.use_theme_colors == false
    assign use_theme_colors = false
  endif
  assign bg = s.background_color
  assign surface = s.surface_color
  assign text_color = s.text_color
  assign mute = s.muted_color
  assign radius = s.corner_radius | default: 18

  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign has_trust = false
  if trust_blocks.size > 0
    assign has_trust = true
  endif

  assign cta_label = s.cta_label | default: 'Shop collections'
  assign cta_link = s.cta_link
  assign banner_heading = s.banner_heading | default: 'Ready to find your next piece?'
  assign banner_text = s.banner_text | default: 'Explore premium fabrics and designer clothing crafted for lasting beauty.'
  assign banner_label = s.banner_label | default: 'Contact us'
  assign banner_link = s.banner_link
-%}

<div
  class="about-page full-width"
  id="AboutPage-{{ section.id | default: 'fallback' }}"
  style="
    --ap-pad-top: {{ pad_top }}px;
    --ap-pad-bottom: {{ pad_bottom }}px;
    {%- unless use_theme_colors -%}
      --ap-bg: {{ bg }};
      --ap-surface: {{ surface }};
      --ap-text: {{ text_color }};
      --ap-mute: {{ mute }};
    {%- endunless -%}
    --ap-radius: {{ radius }}px;
  "
  {% if section %}{{ section.shopify_attributes }}{% endif %}
>
  <div class="about-page__shell">
    <div class="about-page__inner">
      <header class="about-page__header about-page__header--{{ header_alignment }}">
        {%- if eyebrow != blank -%}
          <p class="about-page__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="about-page__heading">{{ heading | escape }}</h1>
        <span class="about-page__rule" aria-hidden="true"></span>
        {%- if subheading != blank -%}
          <div class="about-page__subheading">{{ subheading }}</div>
        {%- else -%}
          <p class="about-page__subheading">
            Premium unstitched fabric and designer clothing from Jhelum (Dina City).
          </p>
        {%- endif -%}
      </header>

      <div class="about-page__story about-page__story--{{ image_position }}">
        <div class="about-page__media">
          {%- if s.image != blank -%}
            {%- assign image_alt = s.image.alt | default: heading -%}
            {{
              s.image
              | image_url: width: 1600
              | image_tag:
                loading: 'eager',
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 48vw, 100vw',
                class: 'about-page__image',
                alt: image_alt
            }}
          {%- else -%}
            <div class="about-page__placeholder" aria-hidden="true">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'about-page__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="about-page__copy">
          {%- if story_eyebrow != blank -%}
            <p class="about-page__story-eyebrow">{{ story_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if story_heading != blank -%}
            <h2 class="about-page__story-heading">{{ story_heading | escape }}</h2>
          {%- endif -%}
          <div class="about-page__story-text">{{ story_text }}</div>
          {%- if cta_label != blank -%}
            {%- if cta_link != blank -%}
              <a class="about-page__cta" href="{{ cta_link }}">
                {{ cta_label | escape }}
                <span aria-hidden="true">→</span>
              </a>
            {%- else -%}
              <a class="about-page__cta" href="{{ routes.all_products_collection_url }}">
                {{ cta_label | escape }}
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <div class="about-page__mv">
        <article class="about-page__mv-card">
          <p class="about-page__mv-label">{{ 'about.mission_label' | t }}</p>
          <h2 class="about-page__mv-heading">{{ mission_heading | escape }}</h2>
          <p class="about-page__mv-text">{{ mission_text | escape }}</p>
        </article>
        <article class="about-page__mv-card">
          <p class="about-page__mv-label">{{ 'about.vision_label' | t }}</p>
          <h2 class="about-page__mv-heading">{{ vision_heading | escape }}</h2>
          <p class="about-page__mv-text">{{ vision_text | escape }}</p>
        </article>
      </div>

      <figure class="about-page__ceo{% if ceo_image != blank %} about-page__ceo--with-photo{% endif %}" itemscope itemtype="https://schema.org/Quotation">
        <div class="about-page__ceo-body">
          <blockquote class="about-page__ceo-quote" itemprop="text">
            <p class="about-page__ceo-label">{{ ceo_heading | escape }}</p>
            <p class="about-page__ceo-text">{{ ceo_text | escape }}</p>
          </blockquote>
          <figcaption
            class="about-page__ceo-name"
            itemprop="author"
            itemscope
            itemtype="https://schema.org/Person"
          >
            <span itemprop="name">{{ ceo_name | escape }}</span>
            {%- if ceo_role != blank -%}
              <meta itemprop="jobTitle" content="{{ ceo_role | escape }}">
            {%- endif -%}
            <meta itemprop="worksFor" content="{{ shop.name | escape }}">
            {%- if ceo_image != blank -%}
              <meta itemprop="image" content="https:{{ ceo_image | image_url: width: 800 }}">
            {%- endif -%}
          </figcaption>
        </div>
        {%- if ceo_image != blank -%}
          <div class="about-page__ceo-media">
            {{
              ceo_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '480, 720, 960, 1200',
                sizes: '(min-width: 750px) 36vw, 100vw',
                class: 'about-page__ceo-image',
                alt: ceo_image_alt,
                decoding: 'async'
            }}
          </div>
        {%- endif -%}
      </figure>

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Quotation",
        "text": {{ ceo_text | json }},
        "author": {
          "@type": "Person",
          "name": {{ ceo_name | json }},
          "jobTitle": {{ ceo_role | json }},
          "worksFor": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          }
          {%- if ceo_image != blank -%}
          ,"image": {{ ceo_image | image_url: width: 800 | prepend: 'https:' | json }}
          {%- endif -%}
          ,"description": {{ ceo_text | truncate: 300 | json }}
        }
      }
      </script>

      <ul class="about-page__trust" role="list">
        {%- if has_trust -%}
          {%- for block in trust_blocks -%}
            <li class="about-page__trust-item" {{ block.shopify_attributes }}>
              <span class="about-page__trust-index" aria-hidden="true">
                {%- if forloop.index < 10 -%}0{{ forloop.index }}{%- else -%}{{ forloop.index }}{%- endif -%}
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="about-page__trust-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="about-page__trust-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="about-page__trust-item">
            <span class="about-page__trust-index" aria-hidden="true">01</span>
            <h3 class="about-page__trust-title">{{ 'about.trust_money_title' | t }}</h3>
            <p class="about-page__trust-text">{{ 'about.trust_money_text' | t }}</p>
          </li>
          <li class="about-page__trust-item">
            <span class="about-page__trust-index" aria-hidden="true">02</span>
            <h3 class="about-page__trust-title">{{ 'about.trust_support_title' | t }}</h3>
            <p class="about-page__trust-text">{{ 'about.trust_support_text' | t }}</p>
          </li>
          <li class="about-page__trust-item">
            <span class="about-page__trust-index" aria-hidden="true">03</span>
            <h3 class="about-page__trust-title">{{ 'about.trust_delivery_title' | t }}</h3>
            <p class="about-page__trust-text">{{ 'about.trust_delivery_text' | t }}</p>
          </li>
          <li class="about-page__trust-item">
            <span class="about-page__trust-index" aria-hidden="true">04</span>
            <h3 class="about-page__trust-title">{{ 'about.trust_secure_title' | t }}</h3>
            <p class="about-page__trust-text">{{ 'about.trust_secure_text' | t }}</p>
          </li>
        {%- endif -%}
      </ul>

      {%- if banner_heading != blank or banner_text != blank -%}
        <aside class="about-page__banner">
          <div class="about-page__banner-copy">
            {%- if banner_heading != blank -%}
              <h2 class="about-page__banner-heading">{{ banner_heading | escape }}</h2>
            {%- endif -%}
            {%- if banner_text != blank -%}
              <p class="about-page__banner-text">{{ banner_text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if banner_label != blank -%}
            <a
              class="about-page__banner-cta"
              href="{% if banner_link != blank %}{{ banner_link }}{% else %}/pages/contact{% endif %}"
            >
              {{ banner_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .about-page {
    --ap-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ap-line: color-mix(in srgb, var(--color-heading) 10%, transparent);
    display: block;
    color: var(--ap-text, var(--color-text));
    background: var(--ap-bg, var(--color-background));
  }

  .about-page__shell {
    padding-block: var(--ap-pad-top) var(--ap-pad-bottom);
  }

  .about-page__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.75rem);
  }

  .about-page__header {
    display: grid;
    gap: 0.9rem;
    max-width: 48rem;
  }

  .about-page__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .about-page__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__heading {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .about-page__rule {
    display: block;
    width: 3rem;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .about-page__header--center .about-page__rule {
    margin-inline: auto;
  }

  .about-page__subheading {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__subheading p {
    margin: 0;
  }

  .about-page__story {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: center;
  }

  @media (min-width: 990px) {
    .about-page__story {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .about-page__story--right .about-page__media {
      order: 2;
    }

    .about-page__story--right .about-page__copy {
      order: 1;
    }
  }

  .about-page__media {
    overflow: hidden;
    border-radius: var(--ap-radius, 18px);
    background: var(--color-border);
    min-height: 18rem;
  }

  .about-page__image,
  .about-page__placeholder,
  .about-page__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 990px) {
    .about-page__image,
    .about-page__placeholder,
    .about-page__placeholder-svg {
      aspect-ratio: 5 / 6;
      min-height: 32rem;
    }
  }

  .about-page__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--color-border), var(--color-surface));
  }

  .about-page__placeholder-svg {
    opacity: 0.45;
  }

  .about-page__copy {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .about-page__story-eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__story-heading {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .about-page__story-text {
    margin: 0;
    max-width: 36rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__story-text p {
    margin: 0;
  }

  .about-page__story-text p + p {
    margin-top: 1rem;
  }

  .about-page__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin-top: 0.25rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .about-page__cta:hover,
  .about-page__cta:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.28em;
  }

  .about-page__mv {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .about-page__mv {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .about-page__mv-card {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border: 1px solid var(--ap-line);
    border-radius: calc(var(--ap-radius, 18px) - 2px);
    background: var(--ap-surface, var(--color-surface));
  }

  .about-page__mv-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__mv-heading {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .about-page__mv-text {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__ceo {
    margin: 0;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--ap-radius, 18px);
    background: var(--color-button);
    color: var(--color-button-text);
  }

  .about-page__ceo--with-photo {
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 750px) {
    .about-page__ceo--with-photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .about-page__ceo-media {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--ap-radius, 18px);
    background: color-mix(in srgb, var(--color-background) 14%, transparent);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    box-sizing: border-box;
  }

  .about-page__ceo-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .about-page__ceo-body {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    align-content: center;
  }

  .about-page__ceo-quote {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .about-page__ceo-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-background) 55%, transparent);
  }

  .about-page__ceo-text {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.55;
  }

  .about-page__ceo-name {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-background) 70%, transparent);
  }

  .about-page__trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .about-page__trust {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 990px) {
    .about-page__trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .about-page__trust-item {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding: 1.25rem 1.15rem 1.35rem;
    border: 1px solid var(--ap-line);
    border-radius: calc(var(--ap-radius, 18px) - 4px);
    background: var(--color-background);
    transition: transform 220ms var(--ap-ease), border-color 220ms ease;
  }

  .about-page__trust-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-heading) 18%, transparent);
  }

  .about-page__trust-index {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__trust-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .about-page__trust-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__banner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--ap-radius, 18px);
    background: var(--ap-surface, var(--color-surface));
    border: 1px solid var(--ap-line);
  }

  @media (min-width: 750px) {
    .about-page__banner {
      grid-template-columns: 1fr auto;
      gap: 2rem;
    }
  }

  .about-page__banner-copy {
    display: grid;
    gap: 0.45rem;
  }

  .about-page__banner-heading {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .about-page__banner-text {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ap-mute, var(--color-text-muted));
  }

  .about-page__banner-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0 1.2rem;
    border-radius: 999px;
    background: var(--color-button);
    color: var(--color-button-text);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
