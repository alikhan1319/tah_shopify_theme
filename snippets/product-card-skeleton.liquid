{% doc %}
  Skeleton placeholder for a product card while media / data loads.

  @param {string} [class] - Extra class

  @example
  {% render 'product-card-skeleton' %}
{% enddoc %}

<div class="product-card-skeleton {{ class }}" aria-hidden="true">
  <div class="product-card-skeleton__media" data-skeleton></div>
  <div class="product-card-skeleton__info">
    <span class="product-card-skeleton__line product-card-skeleton__line--sm"></span>
    <span class="product-card-skeleton__line product-card-skeleton__line--lg"></span>
    <span class="product-card-skeleton__line product-card-skeleton__line--md"></span>
    <span class="product-card-skeleton__btn"></span>
  </div>
</div>

{% stylesheet %}
  .product-card-skeleton {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-background);
  }

  .product-card-skeleton__media {
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
  }

  .product-card-skeleton__info {
    display: grid;
    gap: 0.55rem;
    padding: 12px;
  }

  .product-card-skeleton__line,
  .product-card-skeleton__btn {
    display: block;
    border-radius: 6px;
    background: linear-gradient(
      110deg,
      var(--color-surface) 0%,
      var(--color-surface) 35%,
      color-mix(in srgb, var(--color-background) 80%, var(--color-border)) 50%,
      var(--color-surface) 65%,
      var(--color-surface) 100%
    );
    background-size: 220% 100%;
    animation: tah-skeleton-shimmer 1.15s ease-in-out infinite;
  }

  .product-card-skeleton__line--sm { height: 10px; width: 42%; }
  .product-card-skeleton__line--lg { height: 14px; width: 88%; }
  .product-card-skeleton__line--md { height: 18px; width: 55%; }
  .product-card-skeleton__btn { height: 48px; width: 100%; margin-top: 0.35rem; border-radius: 10px; }

  @media (prefers-reduced-motion: reduce) {
    .product-card-skeleton__line,
    .product-card-skeleton__btn {
      animation: none;
    }
  }
{% endstylesheet %}
