{% doc %}
  Renders AJAX predictive search UI powered by Shopify Suggest API.

  @param {string} section_id - Parent section id for unique input ids
  @param {number} [limit] - Max results to fetch
  @param {boolean} [show_vendor] - Whether to show product vendor

  @example
  {% render 'predictive-search', section_id: section.id, limit: 6 %}
{% enddoc %}

{%- liquid
  assign result_limit = limit | default: 6
  assign include_vendor = show_vendor | default: false
-%}

<predictive-search
  class="predictive-search"
  data-section-id="{{ section_id }}"
  data-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  data-limit="{{ result_limit }}"
  data-show-vendor="{{ include_vendor }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="predictive-search__form"
    data-predictive-search-form
  >
    <label class="visually-hidden" for="PredictiveSearch-{{ section_id }}">
      {{ 'search.title' | t }}
    </label>
    <div class="predictive-search__field">
      <span class="predictive-search__icon" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
      <input
        id="PredictiveSearch-{{ section_id }}"
        class="predictive-search__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        role="combobox"
        aria-expanded="false"
        aria-owns="PredictiveSearchResults-{{ section_id }}"
        aria-controls="PredictiveSearchResults-{{ section_id }}"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        data-predictive-search-input
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button
        type="button"
        class="predictive-search__reset is-hidden"
        data-predictive-search-reset
        aria-label="{{ 'accessibility.clear_search' | t }}"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>
  </form>

  <div
    id="PredictiveSearchResults-{{ section_id }}"
    class="predictive-search__results"
    data-predictive-search-results
    tabindex="-1"
  >
    <div class="predictive-search__status visually-hidden" role="status" data-predictive-search-status></div>
    <div class="predictive-search__loading is-hidden" data-predictive-search-loading>
      {{ 'search.searching' | t }}
    </div>
    <div class="predictive-search__empty is-hidden" data-predictive-search-empty>
      {{ 'search.no_results_short' | t }}
    </div>
    <ul
      class="predictive-search__list"
      role="listbox"
      data-predictive-search-list
      hidden
    ></ul>
    <a
      class="predictive-search__view-all is-hidden"
      data-predictive-search-view-all
      href="{{ routes.search_url }}"
    >
      {{ 'search.view_all' | t }}
    </a>
  </div>
</predictive-search>

{% stylesheet %}
  .predictive-search {
    display: block;
    width: 100%;
  }

  .predictive-search__form {
    margin: 0;
  }

  .predictive-search__field {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-heading) 16%, transparent);
  }

  .predictive-search__icon,
  .predictive-search__reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: inherit;
    flex-shrink: 0;
  }

  .predictive-search__icon svg,
  .predictive-search__reset svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .predictive-search__reset {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .predictive-search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0.04em;
    padding: 0.85rem 0;
    outline: none;
  }

  .predictive-search__input::-webkit-search-decoration,
  .predictive-search__input::-webkit-search-cancel-button,
  .predictive-search__input::-webkit-search-results-button,
  .predictive-search__input::-webkit-search-results-decoration {
    display: none;
  }

  .predictive-search__results {
    margin-top: 1rem;
    max-height: min(60vh, 28rem);
    overflow: auto;
  }

  .predictive-search__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .predictive-search__item {
    margin: 0;
  }

  .predictive-search__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.65rem 0.25rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .predictive-search__link:hover,
  .predictive-search__link:focus-visible,
  .predictive-search__link.is-active {
    background: color-mix(in srgb, var(--color-heading) 4%, transparent);
  }

  .predictive-search__media {
    width: 3.5rem;
    aspect-ratio: 1;
    background: var(--color-surface);
    overflow: hidden;
  }

  .predictive-search__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .predictive-search__meta {
    min-width: 0;
  }

  .predictive-search__title {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
  }

  .predictive-search__vendor {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .predictive-search__price {
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .predictive-search__loading,
  .predictive-search__empty {
    padding: 1rem 0.25rem;
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .predictive-search__view-all {
    display: inline-flex;
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--color-heading) 8%, transparent);
    width: 100%;
    color: inherit;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .predictive-search__view-all:hover {
    opacity: 0.65;
  }

  .is-hidden {
    display: none !important;
  }
{% endstylesheet %}

{% javascript %}
  class PredictiveSearch extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      this.input = this.querySelector('[data-predictive-search-input]');
      this.resetButton = this.querySelector('[data-predictive-search-reset]');
      this.results = this.querySelector('[data-predictive-search-results]');
      this.list = this.querySelector('[data-predictive-search-list]');
      this.status = this.querySelector('[data-predictive-search-status]');
      this.loading = this.querySelector('[data-predictive-search-loading]');
      this.empty = this.querySelector('[data-predictive-search-empty]');
      this.viewAll = this.querySelector('[data-predictive-search-view-all]');
      this.endpoint = this.dataset.url;
      this.searchUrl = this.dataset.searchUrl;
      this.limit = Number(this.dataset.limit || 6);
      this.showVendor = this.dataset.showVendor === 'true';
      this.abortController = null;
      this.debounceTimer = null;
      this.activeIndex = -1;

      this.onInput = () => this.onQueryChange();
      this.onReset = () => this.clear();
      this.onKeyDown = (event) => this.handleKeys(event);

      this.input?.addEventListener('input', this.onInput);
      this.input?.addEventListener('keydown', this.onKeyDown);
      this.resetButton?.addEventListener('click', this.onReset);
    }

    disconnectedCallback() {
      this.input?.removeEventListener('input', this.onInput);
      this.input?.removeEventListener('keydown', this.onKeyDown);
      this.resetButton?.removeEventListener('click', this.onReset);
      this.abortController?.abort();
      window.clearTimeout(this.debounceTimer);
    }

    onQueryChange() {
      const term = this.input.value.trim();
      this.resetButton?.classList.toggle('is-hidden', term.length === 0);
      this.input?.setAttribute('aria-expanded', term.length > 1 ? 'true' : 'false');

      window.clearTimeout(this.debounceTimer);
      if (term.length < 2) {
        this.resetResults();
        return;
      }

      this.debounceTimer = window.setTimeout(() => this.search(term), 220);
    }

    async search(term) {
      this.abortController?.abort();
      this.abortController = new AbortController();
      this.setLoading(true);

      const url = new URL(this.endpoint, window.location.origin);
      url.searchParams.set('q', term);
      url.searchParams.set('resources[type]', 'product');
      url.searchParams.set('resources[limit]', String(this.limit));
      url.searchParams.set('resources[options][unavailable_products]', 'last');
      url.searchParams.set('resources[options][fields]', 'title,product_type,variants.title,vendor');

      try {
        const response = await fetch(url.toString(), {
          signal: this.abortController.signal,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Predictive search failed');
        const data = await response.json();
        this.renderResults(term, data?.resources?.results?.products || []);
      } catch (error) {
        if (error.name !== 'AbortError') console.error(error);
      } finally {
        this.setLoading(false);
      }
    }

    renderResults(term, products) {
      this.activeIndex = -1;
      this.list.innerHTML = '';

      if (!products.length) {
        this.list.hidden = true;
        this.empty?.classList.remove('is-hidden');
        this.viewAll?.classList.add('is-hidden');
        if (this.status) this.status.textContent = 'No results';
        return;
      }

      this.empty?.classList.add('is-hidden');
      this.list.hidden = false;

      const fragment = document.createDocumentFragment();
      products.forEach((product, index) => {
        const li = document.createElement('li');
        li.className = 'predictive-search__item';
        li.setAttribute('role', 'option');
        li.id = `PredictiveSearchOption-${this.dataset.sectionId}-${index}`;

        const price = this.formatMoney(product.price);
        const image = product.image
          ? `<div class="predictive-search__media"><img src="${product.image}" alt="" width="70" height="70" loading="lazy"></div>`
          : `<div class="predictive-search__media" aria-hidden="true"></div>`;
        const vendor = this.showVendor && product.vendor
          ? `<p class="predictive-search__vendor">${this.escape(product.vendor)}</p>`
          : '';

        li.innerHTML = `
          <a class="predictive-search__link" href="${product.url}" data-index="${index}">
            ${image}
            <div class="predictive-search__meta">
              <p class="predictive-search__title">${this.escape(product.title)}</p>
              ${vendor}
            </div>
            <div class="predictive-search__price">${price}</div>
          </a>
        `;
        fragment.appendChild(li);
      });

      this.list.appendChild(fragment);
      if (this.viewAll) {
        this.viewAll.href = `${this.searchUrl}?q=${encodeURIComponent(term)}`;
        this.viewAll.classList.remove('is-hidden');
      }
      if (this.status) {
        this.status.textContent = `${products.length} results`;
      }
    }

    handleKeys(event) {
      const links = Array.from(this.querySelectorAll('.predictive-search__link'));
      if (!links.length) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        this.activeIndex = (this.activeIndex + 1) % links.length;
        this.paintActive(links);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        this.activeIndex = (this.activeIndex - 1 + links.length) % links.length;
        this.paintActive(links);
      } else if (event.key === 'Enter' && this.activeIndex >= 0) {
        event.preventDefault();
        links[this.activeIndex].click();
      } else if (event.key === 'Escape') {
        this.clear();
        this.closest('header-search')?.close?.();
      }
    }

    paintActive(links) {
      links.forEach((link, index) => {
        link.classList.toggle('is-active', index === this.activeIndex);
      });
      this.input?.setAttribute(
        'aria-activedescendant',
        `PredictiveSearchOption-${this.dataset.sectionId}-${this.activeIndex}`
      );
    }

    setLoading(isLoading) {
      this.loading?.classList.toggle('is-hidden', !isLoading);
    }

    resetResults() {
      this.list.innerHTML = '';
      this.list.hidden = true;
      this.empty?.classList.add('is-hidden');
      this.viewAll?.classList.add('is-hidden');
      this.loading?.classList.add('is-hidden');
      if (this.status) this.status.textContent = '';
      this.input?.setAttribute('aria-expanded', 'false');
      this.input?.removeAttribute('aria-activedescendant');
    }

    clear() {
      if (this.input) this.input.value = '';
      this.resetButton?.classList.add('is-hidden');
      this.resetResults();
      this.input?.focus();
    }

    escape(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    formatMoney(cents) {
      const amount = (Number(cents) / 100).toFixed(2);
      const format = this.dataset.moneyFormat || '${{amount}}';
      return format
        .replace('{{amount_with_comma_separator}}', amount.replace('.', ','))
        .replace('{{amount_no_decimals}}', String(Math.round(Number(cents) / 100)))
        .replace('{{amount}}', amount);
    }
  }

  if (!customElements.get('predictive-search')) {
    customElements.define('predictive-search', PredictiveSearch);
  }
{% endjavascript %}
