{% doc %}
  Renders the live search used in the header search panel.
  Results are loaded from the `predictive-search` section through the
  Section Rendering API, so products appear in the theme's product card.

  @param {string} section_id - Parent section id for unique input ids
  @param {number} [limit] - Max products to show
  @param {boolean} [show_vendor] - Whether to show product vendor
  @param {string} [popular] - Comma-separated popular search terms shown before typing

  @example
  {% render 'predictive-search', section_id: section.id, limit: 6, popular: 'Bridal, Festive' %}
{% enddoc %}

{%- liquid
  assign result_limit = limit | default: 6
  assign include_vendor = show_vendor | default: false
  assign popular_terms = popular | default: '' | split: ','
-%}

<predictive-search
  class="predictive-search{% unless include_vendor %} predictive-search--no-vendor{% endunless %}"
  data-url="{{ routes.predictive_search_url }}"
  data-limit="{{ result_limit }}"
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="predictive-search__form"
    data-predictive-search-form
  >
    <label class="visually-hidden" for="PredictiveSearch-{{ section_id }}">
      {{ 'search.title' | t }}
    </label>
    <div class="predictive-search__field">
      <span class="predictive-search__icon" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
      <input
        id="PredictiveSearch-{{ section_id }}"
        class="predictive-search__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-controls="PredictiveSearchResults-{{ section_id }}"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        data-predictive-search-input
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button
        type="button"
        class="predictive-search__reset is-hidden"
        data-predictive-search-reset
        aria-label="{{ 'accessibility.clear_search' | t }}"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
      <button type="submit" class="predictive-search__submit" aria-label="{{ 'search.submit' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </form>

  <div
    id="PredictiveSearchResults-{{ section_id }}"
    class="predictive-search__results"
    data-predictive-search-results
  >
    <p class="visually-hidden" role="status" data-predictive-search-status></p>

    {%- if popular_terms.size > 0 -%}
      <div class="predictive-search__block" data-predictive-search-idle>
        <p class="predictive-search__heading">{{ 'search.popular' | t }}</p>
        <ul class="predictive-search__chips" role="list">
          {%- for term in popular_terms -%}
            {%- assign clean_term = term | strip -%}
            {%- if clean_term != blank -%}
              <li>
                <a
                  class="predictive-search__chip"
                  href="{{ routes.search_url }}?q={{ clean_term | url_encode }}&amp;options%5Bprefix%5D=last"
                >
                  {{- clean_term | escape -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="predictive-search__grid predictive-search__skeleton" data-predictive-search-skeleton hidden>
      {%- for i in (1..result_limit) -%}
        {% render 'product-card-skeleton' %}
      {%- endfor -%}
    </div>

    <div class="predictive-search__content" data-predictive-search-content hidden></div>
  </div>
</predictive-search>

{% stylesheet %}
  .predictive-search {
    --ps-line: color-mix(in srgb, var(--color-heading) 12%, transparent);
    --ps-ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
    width: 100%;
  }

  .predictive-search [hidden] {
    display: none !important;
  }

  .predictive-search__form {
    width: min(100%, 44rem);
    margin: 0 auto;
  }

  .predictive-search__field {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.3rem 0.3rem 0.85rem;
    border: 1px solid var(--ps-line);
    border-radius: 999px;
    background: var(--color-surface);
    transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
  }

  .predictive-search__field:focus-within {
    border-color: var(--color-accent);
    background: var(--color-background);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .predictive-search__icon,
  .predictive-search__reset {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
  }

  .predictive-search__icon svg,
  .predictive-search__reset svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .predictive-search__reset {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .predictive-search__reset:hover {
    color: var(--color-heading);
  }

  .predictive-search__input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0;
    border: 0;
    background: transparent;
    color: var(--color-heading);
    font: inherit;
    font-size: 1rem;
    outline: none;
  }

  .predictive-search__input::placeholder {
    color: var(--color-text-muted);
  }

  .predictive-search__input::-webkit-search-decoration,
  .predictive-search__input::-webkit-search-cancel-button,
  .predictive-search__input::-webkit-search-results-button,
  .predictive-search__input::-webkit-search-results-decoration {
    display: none;
  }

  .predictive-search__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-button);
    color: var(--color-button-text);
    cursor: pointer;
    transition: background-color 160ms ease, transform 160ms var(--ps-ease);
  }

  .predictive-search__submit:hover,
  .predictive-search__submit:focus-visible {
    background: var(--color-button-hover);
    transform: translateX(2px);
  }

  .predictive-search__results {
    max-height: calc(100dvh - 9.5rem);
    margin-top: 1rem;
    padding: 0.5rem 0.25rem 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .predictive-search__panel {
    display: grid;
    gap: 1.5rem;
  }

  .predictive-search__block {
    display: grid;
    gap: 0.75rem;
  }

  .predictive-search__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .predictive-search__heading {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .predictive-search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 1px solid var(--ps-line);
    border-radius: 999px;
    color: var(--color-heading);
    font-size: 0.85rem;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .predictive-search__chip mark {
    background: none;
    color: var(--color-accent);
    font-weight: 700;
  }

  .predictive-search__chip--collection::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.5rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .predictive-search__chip:hover,
  .predictive-search__chip:focus-visible {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-background));
    color: var(--color-accent);
  }

  .predictive-search__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .predictive-search__view-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .predictive-search__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__item {
    min-width: 0;
  }

  .predictive-search.is-loading .predictive-search__content {
    opacity: 0.45;
    transition: opacity 200ms ease;
  }

  .predictive-search__skeleton > :nth-child(n + 5) {
    display: none;
  }

  /* Compact version of the theme product card for the search panel */
  .predictive-search .product-card {
    padding: 0.45rem;
    border-radius: 18px;
    box-shadow: none;
  }

  .predictive-search .product-card:hover,
  .predictive-search .product-card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--color-heading) 10%, transparent);
  }

  .predictive-search .product-card__media {
    border-radius: 14px;
  }

  .predictive-search .product-card__wish {
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
  }

  .predictive-search .product-card__info {
    gap: 6px;
    padding: 10px 6px 6px;
  }

  .predictive-search .product-card__title {
    font-size: 13.5px;
  }

  .predictive-search .product-card__price {
    font-size: 16px;
  }

  .predictive-search .product-card__atc {
    height: 40px;
    font-size: 13px;
  }

  .predictive-search--no-vendor .product-card__meta-row {
    display: none;
  }

  .predictive-search__empty {
    display: grid;
    gap: 0.35rem;
    padding: 1.75rem 1rem;
    border-radius: 18px;
    background: var(--color-surface);
    text-align: center;
  }

  .predictive-search__empty-title,
  .predictive-search__empty-tip {
    margin: 0;
  }

  .predictive-search__empty-title {
    font-weight: 700;
    color: var(--color-heading);
  }

  .predictive-search__empty-tip {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 750px) {
    .predictive-search__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .predictive-search__skeleton > :nth-child(n + 5) {
      display: block;
    }

    .predictive-search__skeleton > :nth-child(n + 7) {
      display: none;
    }
  }

  @media (min-width: 990px) {
    .predictive-search__grid {
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
      gap: 1rem;
    }

    .predictive-search__skeleton > :nth-child(n + 7) {
      display: block;
    }
  }

  .is-hidden {
    display: none !important;
  }
{% endstylesheet %}

{% javascript %}
  class PredictiveSearch extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      this.input = this.querySelector('[data-predictive-search-input]');
      this.resetButton = this.querySelector('[data-predictive-search-reset]');
      this.results = this.querySelector('[data-predictive-search-results]');
      this.status = this.querySelector('[data-predictive-search-status]');
      this.idle = this.querySelector('[data-predictive-search-idle]');
      this.skeleton = this.querySelector('[data-predictive-search-skeleton]');
      this.content = this.querySelector('[data-predictive-search-content]');
      this.endpoint = this.dataset.url;
      this.limit = Number(this.dataset.limit || 6);
      this.cache = new Map();
      this.abortController = null;
      this.debounceTimer = null;

      this.onInput = () => this.onQueryChange();
      this.onReset = () => this.clear();
      this.onKeyDown = (event) => this.handleKeys(event);

      this.input?.addEventListener('input', this.onInput);
      this.input?.addEventListener('keydown', this.onKeyDown);
      this.resetButton?.addEventListener('click', this.onReset);
    }

    disconnectedCallback() {
      this.input?.removeEventListener('input', this.onInput);
      this.input?.removeEventListener('keydown', this.onKeyDown);
      this.resetButton?.removeEventListener('click', this.onReset);
      this.abortController?.abort();
      window.clearTimeout(this.debounceTimer);
    }

    onQueryChange() {
      const term = this.input.value.trim();
      this.resetButton?.classList.toggle('is-hidden', term.length === 0);

      window.clearTimeout(this.debounceTimer);
      if (term.length < 2) {
        this.showIdle();
        return;
      }

      this.debounceTimer = window.setTimeout(() => this.search(term), 220);
    }

    async search(term) {
      const cached = this.cache.get(term);
      if (cached) {
        this.abortController?.abort();
        this.render(cached);
        return;
      }

      this.abortController?.abort();
      const controller = new AbortController();
      this.abortController = controller;
      this.setLoading(true);

      const url = new URL(this.endpoint, window.location.origin);
      url.searchParams.set('q', term);
      url.searchParams.set('section_id', 'predictive-search');
      url.searchParams.set('resources[type]', 'product,query,collection');
      url.searchParams.set('resources[limit]', String(this.limit));
      url.searchParams.set('resources[limit_scope]', 'each');
      url.searchParams.set('resources[options][unavailable_products]', 'last');
      url.searchParams.set('resources[options][fields]', 'title,product_type,variants.title,vendor,tag');

      try {
        const response = await fetch(url.toString(), { signal: controller.signal });
        if (!response.ok) throw new Error('Predictive search failed');

        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const panel = doc.querySelector('[data-predictive-results]');
        if (!panel) throw new Error('Predictive search section missing');

        const result = { html: panel.outerHTML, status: panel.dataset.status || '' };
        this.cache.set(term, result);
        if (this.input.value.trim() === term) this.render(result);
      } catch (error) {
        if (error.name === 'AbortError') return;
        console.error(error);
        this.setLoading(false);
      }
    }

    render({ html, status }) {
      this.setLoading(false);
      if (this.idle) this.idle.hidden = true;

      // Assign from a string so the injected <product-card> elements upgrade and bind.
      this.content.innerHTML = html;
      this.content.hidden = false;

      window.TahReveal?.boot?.(this.content);
      document.dispatchEvent(new CustomEvent('wishlist:updated'));
      if (this.status) this.status.textContent = status;
    }

    setLoading(isLoading) {
      this.classList.toggle('is-loading', isLoading);
      if (!this.skeleton) return;

      if (isLoading) {
        if (this.idle) this.idle.hidden = true;
        // First search shows card placeholders; later searches dim the current results.
        this.skeleton.hidden = !this.content.hidden;
      } else {
        this.skeleton.hidden = true;
      }
    }

    showIdle() {
      this.abortController?.abort();
      this.setLoading(false);
      this.content.innerHTML = '';
      this.content.hidden = true;
      if (this.idle) this.idle.hidden = false;
      if (this.status) this.status.textContent = '';
    }

    handleKeys(event) {
      if (event.key !== 'ArrowDown') return;

      const first = this.content?.querySelector('a[href]:not([tabindex="-1"])');
      if (!first || this.content.hidden) return;

      event.preventDefault();
      first.focus();
    }

    clear() {
      if (this.input) this.input.value = '';
      this.resetButton?.classList.add('is-hidden');
      this.showIdle();
      this.input?.focus();
    }
  }

  if (!customElements.get('predictive-search')) {
    customElements.define('predictive-search', PredictiveSearch);
  }
{% endjavascript %}
