{% doc %}
  Renders a reusable section heading block.

  @param {string} [eyebrow] - Optional small label above the heading
  @param {string} [heading] - Main heading
  @param {string} [subheading] - Supporting text
  @param {string} [link] - Optional CTA URL
  @param {string} [link_label] - Optional CTA label
  @param {string} [align] - left | center
  @param {string} [class] - Extra class names

  @example
  {% render 'section-header', heading: section.settings.heading, align: 'center' %}
{% enddoc %}

{%- liquid
  assign align_class = align | default: 'center'
-%}

{%- if eyebrow != blank or heading != blank or subheading != blank or link != blank -%}
  <div class="section-header section-header--{{ align_class }} {{ class }}">
    {%- if eyebrow != blank -%}
      <p class="section-header__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}
    {%- if heading != blank -%}
      <h2 class="section-header__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    {%- if subheading != blank -%}
      <div class="section-header__subheading">{{ subheading }}</div>
    {%- endif -%}
    {%- if link != blank and link_label != blank -%}
      <a class="section-header__link" href="{{ link }}">{{ link_label | escape }}</a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .section-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    max-width: 42rem;
  }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .section-header--left {
    text-align: left;
    justify-items: start;
  }

  .section-header__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .section-header__heading {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .section-header__subheading {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.65;
    opacity: 0.72;
  }

  .section-header__subheading p {
    margin: 0;
  }

  .section-header__link {
    margin-top: 0.35rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 100% 1px;
  }

  .section-header__link:hover {
    opacity: 0.7;
  }
{% endstylesheet %}
