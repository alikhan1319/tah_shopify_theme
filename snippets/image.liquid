{% doc %}
  Renders a responsive CDN image, optionally wrapped in a link.

  @param {image} image - The image to be rendered
  @param {string} [url] - Optional destination URL
  @param {string} [class] - Wrapper class
  @param {number} [width] - Max width
  @param {number} [height] - Optional height
  @param {string} [crop] - Crop position
  @param {string} [loading] - lazy | eager
  @param {string} [sizes] - sizes attribute
  @param {string} [alt] - Alt text
{% enddoc %}

{%- if image != blank -%}
  {%- liquid
    unless height
      assign width = width | default: 1200
    endunless

    if url
      assign wrapper = 'a'
    else
      assign wrapper = 'div'
    endif

    assign img_alt = alt | default: image.alt | default: ''
    assign loading_attr = loading | default: 'lazy'
    assign sizes_attr = sizes | default: '100vw'
  -%}

  <{{ wrapper }}
    class="image {{ class }}"
    {% if url %}href="{{ url }}"{% endif %}
  >
    {% render 'cdn-image',
      image: image,
      alt: img_alt,
      widths: width,
      height: height,
      crop: crop,
      loading: loading_attr,
      sizes: sizes_attr
    %}
  </{{ wrapper }}>
{%- endif -%}

{% stylesheet %}
  .image {
    display: block;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: auto;
  }

  .image > img {
    width: 100%;
    height: auto;
    display: block;
  }
{% endstylesheet %}
