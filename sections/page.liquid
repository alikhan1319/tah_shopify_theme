{% comment %}
  Default page section. About / about-us pages automatically get the modern
  About layout so the page works even when the about template is not assigned.
{% endcomment %}

{%- liquid
  assign is_about_page = false
  if page.handle == 'about-us' or page.handle == 'about'
    assign is_about_page = true
  endif

  assign is_legal_page = false
  if page.handle == 'privacy-policy' or page.handle == 'privacy' or page.handle == 'terms-and-conditions' or page.handle == 'terms-of-service' or page.handle == 'terms' or page.handle == 'terms-conditions' or page.handle == 'return-exchange-policy' or page.handle == 'returns-exchanges' or page.handle == 'returns-and-exchanges' or page.handle == 'return-and-exchange' or page.handle == 'returns' or page.handle == 'return-policy' or page.handle == 'refund-policy' or page.handle == 'return-exchange' or page.handle == 'returns-exchange' or page.handle == 'shipping-policy' or page.handle == 'return' or page.handle == 'exchange' or page.handle == 'exchanges'
    assign is_legal_page = true
  endif
-%}

{%- if is_about_page -%}
  {% render 'about-page', section: section, page_title: page.title %}
{%- elsif is_legal_page -%}
  {% render 'legal-auto', page_obj: page %}
{%- else -%}
  <div
    class="page-main full-width"
    style="
      --pg-pad-top: {{ section.settings.padding_top | default: 64 }}px;
      --pg-pad-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    "
  >
    <div class="page-main__inner">
      <header class="page-main__header">
        <h1 class="page-main__heading">{{ page.title | escape }}</h1>
        <span class="page-main__rule" aria-hidden="true"></span>
      </header>
      <div class="page-main__content rte">
        {{ page.content }}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .page-main {
    display: block;
    background: var(--color-background);
    color: var(--color-heading);
  }

  .page-main__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
    padding-block: var(--pg-pad-top, 64px) var(--pg-pad-bottom, 80px);
  }

  .page-main__header {
    display: grid;
    gap: 0.85rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 42rem;
  }

  .page-main__heading {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .page-main__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .page-main__content {
    max-width: 42rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .page-main__content > *:first-child {
    margin-top: 0;
  }

  .page-main__content > *:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

