{%- liquid
  assign selected_blog = section.settings.blog
  assign posts_limit = section.settings.posts_to_show
  assign show_author = section.settings.show_author
  assign show_excerpt = section.settings.show_excerpt
  assign show_date = section.settings.show_date

  assign cta_label = section.settings.link_label
  if cta_label == blank
    assign cta_label = 'general.view_all' | t
  endif

  assign show_footer_cta = false
  if section.settings.show_cta and selected_blog != blank and cta_label != blank
    assign show_footer_cta = true
  endif
-%}

<div
  class="journal full-width"
  id="Journal-{{ section.id }}"
  style="
    {%- if section.settings.use_theme_colors == false %}--jn-bg: {{ section.settings.color_background }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--jn-text: {{ section.settings.color_text }};{% endif -%}
    --jn-padding-top: {{ section.settings.padding_top }}px;
    --jn-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jn-gap: {{ section.settings.grid_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="journal__shell">
    <div class="journal__inner">
      <header class="journal__header journal__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="journal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="journal__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <span class="journal__rule" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <div class="journal__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>

      {%- if selected_blog == blank -%}
        {%- if request.design_mode -%}
          <p class="journal__empty">{{ 'sections.blog_posts.empty' | t }}</p>
        {%- endif -%}
      {%- elsif selected_blog.articles_count == 0 -%}
        {%- if request.design_mode -%}
          <p class="journal__empty">{{ 'sections.blog_posts.no_articles' | t }}</p>
        {%- endif -%}
      {%- else -%}
        <ul class="journal__grid" role="list">
          {%- for article in selected_blog.articles limit: posts_limit -%}
            <li class="journal__item">
              <article class="journal-card">
                <a class="journal-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                  {%- if article.image -%}
                    {{
                      article.image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw',
                        class: 'journal-card__image',
                        alt: article.image.alt | default: article.title
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'journal-card__placeholder' }}
                  {%- endif -%}
                </a>

                <div class="journal-card__body">
                  <div class="journal-card__meta">
                    {%- if show_date -%}
                      <time class="journal-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                        {{ article.published_at | time_tag: format: 'date' }}
                      </time>
                    {%- endif -%}

                    {%- if show_author and article.author != blank -%}
                      {%- if show_date -%}
                        <span class="journal-card__dot" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="journal-card__author">
                        {{ 'sections.blog_posts.by_author' | t: author: article.author }}
                      </span>
                    {%- endif -%}
                  </div>

                  <h3 class="journal-card__title">
                    <a href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h3>

                  {%- if show_excerpt and article.excerpt_or_content != blank -%}
                    <p class="journal-card__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 22 }}
                    </p>
                  {%- endif -%}

                  <a class="journal-card__link" href="{{ article.url }}">
                    {{ 'sections.blog_posts.read_more' | t }}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if show_footer_cta -%}
          <div class="journal__footer">
            <a class="journal__cta" href="{{ selected_blog.url }}">
              {{ cta_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .journal {
    --jn-mute: var(--color-text-muted);
    --jn-line: var(--color-border);
    --jn-ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--jn-bg, var(--color-background));
    color: var(--jn-text, var(--color-text));
  }

  .journal__shell {
    padding-block: var(--jn-padding-top) var(--jn-padding-bottom);
  }

  .journal__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .journal__header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 40rem;
  }

  .journal__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .journal__header--left {
    text-align: left;
    justify-items: start;
  }

  .journal__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--jn-mute);
  }

  .journal__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .journal__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--jn-text, var(--color-text));
    opacity: 0.85;
  }

  .journal__header--center .journal__rule {
    margin-inline: auto;
  }

  .journal__subheading {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--jn-mute);
  }

  .journal__subheading p {
    margin: 0;
  }

  .journal__empty {
    margin: 0;
    padding: 2.75rem 1.5rem;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--jn-mute);
    border: 1px dashed var(--jn-line);
    border-radius: 12px;
  }

  .journal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: max(1rem, calc(var(--jn-gap) * 0.75));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journal__item {
    min-width: 0;
    display: flex;
  }

  .journal-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid var(--jn-line);
    border-radius: 12px;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-heading) 4%, transparent);
    transition:
      transform 220ms var(--jn-ease),
      box-shadow 220ms var(--jn-ease),
      border-color 220ms ease;
  }

  .journal-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border);
    box-shadow: 0 14px 32px color-mix(in srgb, var(--color-heading) 8%, transparent);
  }

  .journal-card__media {
    display: block;
    overflow: hidden;
    background: var(--color-surface);
  }

  .journal-card__image,
  .journal-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 550ms var(--jn-ease);
  }

  .journal-card:hover .journal-card__image {
    transform: scale(1.04);
  }

  .journal-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 0.65rem;
    padding: 1.15rem 1.15rem 1.25rem;
  }

  .journal-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .journal-card__date,
  .journal-card__author {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--jn-mute);
  }

  .journal-card__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .journal-card__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .journal-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .journal-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .journal-card__excerpt {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--jn-mute);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.35rem;
    color: var(--jn-text, var(--color-text));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: gap 180ms var(--jn-ease), opacity 180ms ease;
  }

  .journal-card__link:hover {
    gap: 0.65rem;
    opacity: 0.72;
  }

  .journal__footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .journal__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.75rem;
    border: 1px solid var(--jn-text, var(--color-button));
    border-radius: 10px;
    color: var(--jn-text, var(--color-text));
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      gap 180ms var(--jn-ease);
  }

  .journal__cta:hover {
    background: var(--color-button);
    color: var(--color-button-text);
    gap: 0.75rem;
  }

  @media (min-width: 750px) {
    .journal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--jn-gap);
    }
  }

  @media (min-width: 990px) {
    .journal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-card,
    .journal-card__image,
    .journal-card__link,
    .journal__cta {
      transition: none;
    }

    .journal-card:hover {
      transform: none;
    }

    .journal-card:hover .journal-card__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog_posts",
  "tag": "section",
  "class": "blog-posts-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From the atelier"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Stories, styling notes, and craft from behind the scenes.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.call_to_action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "t:labels.show_cta",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "t:general.blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "t:labels.posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:labels.foreground",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:general.blog_posts",
      "settings": {
        "eyebrow": "Journal",
        "heading": "From the atelier",
        "subheading": "<p>Stories, styling notes, and craft from behind the scenes.</p>",
        "header_alignment": "center",
        "show_cta": true,
        "link_label": "View all",
        "posts_to_show": 3,
        "show_date": true,
        "show_author": true,
        "show_excerpt": true
      }
    }
  ]
}
{% endschema %}
