{%- liquid
  assign layout = section.settings.layout
  assign has_image = false
  if section.settings.image != blank
    if layout != 'grid_only'
      assign has_image = true
    endif
  endif
  assign feature_count = section.blocks.size
-%}

<div
  class="why-choose full-width why-choose--{{ layout }}"
  id="WhyChoose-{{ section.id }}"
  style="
    {%- if section.settings.use_theme_colors == false %}--wc-bg: {{ section.settings.color_background }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--wc-text: {{ section.settings.color_text }};{% endif -%}
    --wc-padding-top: {{ section.settings.padding_top }}px;
    --wc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="why-choose__shell">
    <div class="why-choose__inner">
      <header class="why-choose__header why-choose__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="why-choose__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="why-choose__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <span class="why-choose__rule" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <div class="why-choose__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>

      {%- if feature_count > 0 or has_image -%}
        <div class="why-choose__body{% unless has_image %} why-choose__body--no-image{% endunless %}">
          {%- if has_image -%}
            <div class="why-choose__media">
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  widths: '500, 700, 900, 1200, 1400',
                  sizes: '(min-width: 990px) 42vw, 100vw',
                  class: 'why-choose__image',
                  alt: section.settings.image.alt | default: section.settings.heading
              }}
            </div>
          {%- endif -%}

          {%- if feature_count > 0 -%}
            <ul class="why-choose__features" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'feature' -%}
                  {%- liquid
                    assign n = forloop.index
                    if n < 10
                      assign feature_index = n | prepend: '0'
                    else
                      assign feature_index = n
                    endif
                  -%}
                  <li class="why-choose__feature" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <div class="why-choose__icon">
                        {{
                          block.settings.icon
                          | image_url: width: 80
                          | image_tag:
                            loading: 'lazy',
                            widths: '40, 56, 80',
                            sizes: '32px',
                            class: 'why-choose__icon-img',
                            alt: ''
                        }}
                      </div>
                    {%- else -%}
                      <span class="why-choose__index" aria-hidden="true">{{ feature_index }}</span>
                    {%- endif -%}

                    <div class="why-choose__content">
                      {%- if block.settings.title != blank -%}
                        <h3 class="why-choose__title">{{ block.settings.title | escape }}</h3>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <p class="why-choose__text">{{ block.settings.text | escape }}</p>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .why-choose {
    --wc-mute: var(--color-text-muted);
    --wc-line: var(--color-border);
    --wc-ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--wc-bg, var(--color-background));
    color: var(--wc-text, var(--color-text));
  }

  .why-choose__shell {
    padding-block: var(--wc-padding-top) var(--wc-padding-bottom);
  }

  .why-choose__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .why-choose__header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 40rem;
  }

  .why-choose__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .why-choose__header--left {
    text-align: left;
    justify-items: start;
  }

  .why-choose__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wc-mute);
  }

  .why-choose__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .why-choose__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--wc-text, var(--color-text));
    opacity: 0.85;
  }

  .why-choose__header--center .why-choose__rule {
    margin-inline: auto;
  }

  .why-choose__subheading {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--wc-mute);
  }

  .why-choose__subheading p {
    margin: 0;
  }

  .why-choose__body {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .why-choose--image_left .why-choose__media {
    order: -1;
  }

  .why-choose__media {
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-surface);
  }

  .why-choose__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .why-choose__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why-choose__feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem 1.2rem;
    background: var(--color-background);
    border: 1px solid var(--wc-line);
    border-radius: 12px;
    transition: border-color 180ms ease, box-shadow 180ms var(--wc-ease);
  }

  .why-choose__feature:hover {
    border-color: var(--color-border);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-heading) 6%, transparent);
  }

  .why-choose__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-button);
    color: var(--color-button-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .why-choose__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
  }

  .why-choose__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .why-choose__content {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .why-choose__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .why-choose__text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--wc-mute);
  }

  @media (min-width: 750px) {
    .why-choose__body:not(.why-choose__body--no-image) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(2rem, 4vw, 3rem);
      align-items: center;
    }

    .why-choose--image_left .why-choose__body:not(.why-choose__body--no-image) {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .why-choose__body--no-image .why-choose__features,
    .why-choose--grid_only .why-choose__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem;
    }
  }

  @media (min-width: 990px) {
    .why-choose__body--no-image .why-choose__features,
    .why-choose--grid_only .why-choose__features {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .why-choose__body:not(.why-choose__body--no-image) .why-choose__features {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-choose__feature {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.why_choose",
  "tag": "section",
  "class": "why-choose-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Why choose Star Fabrics"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Premium textiles, trusted craftsmanship, and dedicated service for every celebration.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "default": "grid_only",
      "options": [
        { "value": "grid_only", "label": "t:options.layout.grid_only" },
        { "value": "image_left", "label": "t:options.layout.image_left" },
        { "value": "image_right", "label": "t:options.layout.image_right" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.side_image"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:labels.foreground",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "t:general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.why_choose.blocks.feature.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:labels.icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Describe this benefit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.why_choose",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Premium quality fabrics",
            "text": "Curated textiles selected for durability, drape, and lasting beauty."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Ethical sourcing",
            "text": "Responsible supply chains you can trust, from mill to doorstep."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Expert craftsmanship",
            "text": "Decades of expertise in every cut, finish, and detail."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Dedicated support",
            "text": "Personal guidance from our fabric specialists at every step."
          }
        }
      ],
      "settings": {
        "layout": "grid_only",
        "header_alignment": "center",
        "color_background": "#FFFFFF",
        "color_text": "#111111"
      }
    }
  ]
}
{% endschema %}
