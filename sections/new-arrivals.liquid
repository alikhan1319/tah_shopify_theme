      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.new_arrivals.presets.name",
      "settings": {
        "eyebrow": "Just landed",
        "heading": "New arrivals",
        "subheading": "<p>Discover the latest additions to our curated collection.</p>",
