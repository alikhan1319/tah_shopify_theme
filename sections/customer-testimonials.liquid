{%- liquid
  assign review_count = section.blocks.size
  assign scroll_seconds = section.settings.scroll_speed | default: 40
-%}

<customer-testimonials-scroll
  class="customer-testimonials full-width{% unless section.settings.enable_auto_scroll %} is-paused{% endunless %}"
  id="CustomerTestimonials-{{ section.id }}"
  data-autoplay="{{ section.settings.enable_auto_scroll }}"
  style="
    --ct-padding-top: {{ section.settings.padding_top }}px;
    --ct-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.use_theme_colors == false %}--ct-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--ct-text: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--ct-card-bg: {{ section.settings.card_background }};{% endif -%}
    --ct-gap: {{ section.settings.card_gap }}px;
    --ct-scroll-duration: {{ scroll_seconds }}s;
  "
  {{ section.shopify_attributes }}
>
  <div class="customer-testimonials__shell">
    <div class="customer-testimonials__inner">
      <header class="customer-testimonials__header customer-testimonials__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="customer-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="customer-testimonials__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <span class="customer-testimonials__rule" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <div class="customer-testimonials__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>
    </div>

    {%- if review_count == 0 -%}
      {%- if request.design_mode -%}
        <div class="customer-testimonials__inner">
          <p class="customer-testimonials__empty">{{ 'sections.customer_testimonials.empty_blocks' | t }}</p>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="customer-testimonials__viewport">
        <div class="customer-testimonials__track" data-track>
          {%- liquid
            assign loop_repeats = 1
            if review_count < 4
              assign loop_repeats = 3
            elsif review_count < 7
              assign loop_repeats = 2
            endif
          -%}
          {%- for copy in (1..2) -%}
            <ul
              class="customer-testimonials__list"
              role="{% if copy == 1 %}list{% else %}presentation{% endif %}"
              {% if copy == 2 %}aria-hidden="true"{% endif %}
              data-testimonial-group
            >
              {%- for repeat in (1..loop_repeats) -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign rating = block.settings.rating | default: 5
                    assign customer_name = block.settings.customer_name
                    assign review_text = block.settings.review_text
                    assign is_primary = false
                    if copy == 1 and repeat == 1
                      assign is_primary = true
                    endif
                  -%}
                  <li
                    class="customer-testimonials__item"
                    {% if is_primary %}id="CustomerTestimonial-{{ section.id }}-{{ block.id }}"{% endif %}
                    {% if is_primary %}{{ block.shopify_attributes }}{% endif %}
                  >
                    <article class="testimonial-card">
                      <div
                        class="testimonial-card__rating"
                        role="img"
                        aria-label="{{ 'sections.customer_testimonials.rating_label' | t: rating: rating, max: 5 }}"
                      >
                        {%- for i in (1..5) -%}
                          <span class="testimonial-card__star{% if i <= rating %} is-on{% endif %}" aria-hidden="true">★</span>
                        {%- endfor -%}
                      </div>

                      {%- if review_text != blank -%}
                        <blockquote class="testimonial-card__quote">
                          <p>{{ review_text | escape }}</p>
                        </blockquote>
                      {%- endif -%}

                      {%- if customer_name != blank -%}
                        <p class="testimonial-card__name">{{ customer_name | escape }}</p>
                      {%- endif -%}
                    </article>
                  </li>
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</customer-testimonials-scroll>

{% stylesheet %}
  .customer-testimonials {
    --ct-ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
    background: var(--ct-bg, var(--color-background));
    color: var(--ct-text, var(--color-text));
    overflow: hidden;
  }

  .customer-testimonials__shell {
    padding-block: var(--ct-padding-top) var(--ct-padding-bottom);
  }

  .customer-testimonials__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .customer-testimonials__header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 40rem;
  }

  .customer-testimonials__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .customer-testimonials__header--left {
    text-align: left;
    justify-items: start;
  }

  .customer-testimonials__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-heading) 48%, transparent);
  }

  .customer-testimonials__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .customer-testimonials__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .customer-testimonials__header--center .customer-testimonials__rule {
    margin-inline: auto;
  }

  .customer-testimonials__subheading {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-heading) 62%, transparent);
  }

  .customer-testimonials__subheading p {
    margin: 0;
  }

  .customer-testimonials__empty {
    margin: 0;
    padding: 2.75rem 1.5rem;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-heading) 62%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-heading) 18%, transparent);
    border-radius: 12px;
  }

  .customer-testimonials__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
  }

  .customer-testimonials__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: customer-testimonials-scroll var(--ct-scroll-duration) linear infinite;
  }

  .customer-testimonials.is-paused .customer-testimonials__track,
  .customer-testimonials:hover .customer-testimonials__track,
  .customer-testimonials:focus-within .customer-testimonials__track {
    animation-play-state: paused;
  }

  @keyframes customer-testimonials-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-1 * var(--ct-loop-distance, 50%)), 0, 0);
    }
  }

  .customer-testimonials__list {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
    gap: var(--ct-gap);
    margin: 0;
    padding: 0;
    padding-inline-end: var(--ct-gap);
    list-style: none;
  }

  .customer-testimonials__item {
    flex: 0 0 auto;
    width: min(82vw, 340px);
  }

  @media (min-width: 750px) {
    .customer-testimonials__item {
      width: min(46vw, 360px);
    }
  }

  @media (min-width: 990px) {
    .customer-testimonials__item {
      width: min(28vw, 380px);
    }
  }

  .testimonial-card {
    height: 100%;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.5rem 1.4rem 1.45rem;
    background: var(--ct-card-bg, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--color-heading) 6%, transparent);
    border-radius: 1.25rem;
    box-shadow:
      0 14px 34px color-mix(in srgb, var(--color-heading) 5%, transparent),
      0 2px 6px color-mix(in srgb, var(--color-heading) 3%, transparent);
  }

  .testimonial-card__rating {
    display: inline-flex;
    gap: 0.15rem;
  }

  .testimonial-card__star {
    font-size: 0.9rem;
    line-height: 1;
    color: color-mix(in srgb, var(--color-heading) 18%, transparent);
  }

  .testimonial-card__star.is-on {
    color: var(--color-star);
  }

  .testimonial-card__quote {
    margin: 0;
  }

  .testimonial-card__quote p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    letter-spacing: -0.015em;
    color: inherit;
  }

  .testimonial-card__name {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-heading) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .customer-testimonials__track {
      animation: none;
    }

    .customer-testimonials__viewport {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .customer-testimonials__track {
      padding-inline: var(--page-margin);
    }

    .customer-testimonials__list[aria-hidden='true'] {
      display: none;
    }

    .customer-testimonials__item {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% javascript %}
  class CustomerTestimonialsScroll extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplay = this.dataset.autoplay === 'true';

      if (!autoplay || reduceMotion) {
        this.classList.add('is-paused');
      }

      this.track = this.querySelector('[data-track]');
      this.syncLoopDistance = () => {
        const group = this.track?.querySelector('[data-testimonial-group], .customer-testimonials__list');
        if (!this.track || !group) return;
        const distance = group.getBoundingClientRect().width;
        if (distance > 0) {
          this.track.style.setProperty('--ct-loop-distance', `${distance}px`);
        }
      };

      this.onResize = () => {
        window.clearTimeout(this._resizeTimer);
        this._resizeTimer = window.setTimeout(() => this.syncLoopDistance(), 120);
      };

      this.syncLoopDistance();
      requestAnimationFrame(() => this.syncLoopDistance());
      window.addEventListener('resize', this.onResize, { passive: true });
    }

    disconnectedCallback() {
      window.removeEventListener('resize', this.onResize);
      window.clearTimeout(this._resizeTimer);
      this._ready = false;
    }
  }

  if (!customElements.get('customer-testimonials-scroll')) {
    customElements.define('customer-testimonials-scroll', CustomerTestimonialsScroll);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.customer_testimonials.name",
  "tag": "section",
  "class": "customer-testimonials-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What customers say about us"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Honest words from clients who chose TAH for their most important moments.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_auto_scroll",
      "label": "t:labels.enable_auto_scroll",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "t:labels.scroll_speed",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "t:info.scroll_speed"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#F6F7F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:labels.card_background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "t:labels.grid_gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.customer_testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "text",
          "id": "customer_name",
          "label": "t:labels.customer_name",
          "default": "Customer name"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "t:labels.review_text",
          "default": "Share a short quote from the customer's review."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:labels.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.customer_testimonials.presets.name",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Ayesha M.",
            "review_text": "The fabric quality and finish felt truly bridal — every detail was refined.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Hassan R.",
            "review_text": "From order to delivery, everything felt premium and carefully handled.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Sara K.",
            "review_text": "Soft hand-feel, rich colour, and packaging that matched the luxury of the piece.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Nadia F.",
            "review_text": "I received so many compliments — the drape was exactly what I hoped for.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
