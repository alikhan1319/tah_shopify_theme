{%- liquid
  assign posts_per_page = section.settings.posts_per_page | default: 9
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign show_excerpt = section.settings.show_excerpt
  assign show_tags = section.settings.show_tags
  assign layout_style = section.settings.layout_style | default: 'featured'
-%}

<div
  class="blog-page full-width"
  id="BlogPage-{{ section.id }}"
  style="
    --bp-pad-top: {{ section.settings.padding_top }}px;
    --bp-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.use_theme_colors == false %}--bp-bg: {{ section.settings.background_color }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--bp-text: {{ section.settings.text_color }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--bp-mute: {{ section.settings.muted_color }};{% endif -%}
    {%- if section.settings.use_theme_colors == false %}--bp-card: {{ section.settings.card_background }};{% endif -%}
    --bp-gap: {{ section.settings.grid_gap }}px;
    --bp-cols-mobile: {{ section.settings.columns_mobile }};
    --bp-cols-tablet: {{ section.settings.columns_tablet }};
    --bp-cols-desktop: {{ section.settings.columns_desktop }};
    --bp-radius: {{ section.settings.card_radius }}px;
    --bp-ratio: {{ section.settings.image_ratio }};
  "
  {{ section.shopify_attributes }}
>
  <div class="blog-page__atmosphere" aria-hidden="true"></div>

  <div class="blog-page__shell">
    <div class="blog-page__inner">
      <header class="blog-page__header blog-page__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="blog-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="blog-page__heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | escape }}
          {%- else -%}
            {{ blog.title | escape }}
          {%- endif -%}
        </h1>

        <span class="blog-page__rule" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <div class="blog-page__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.show_article_count and blog.articles_count > 0 -%}
          <p class="blog-page__count">
            {{ 'blog.article_count' | t: count: blog.articles_count }}
          </p>
        {%- endif -%}
      </header>

      {%- if section.settings.show_tag_filter and blog.all_tags.size > 0 -%}
        <nav class="blog-page__tags" aria-label="{{ 'blog.tags_label' | t }}">
          <a
            class="blog-page__tag{% unless current_tags %} is-active{% endunless %}"
            href="{{ blog.url }}"
          >
            {{ 'blog.all_posts' | t }}
          </a>
          {%- for tag in blog.all_tags -%}
            <a
              class="blog-page__tag{% if current_tags contains tag %} is-active{% endif %}"
              href="{{ blog.url }}/tagged/{{ tag | handle }}"
            >
              {{ tag | escape }}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- paginate blog.articles by posts_per_page -%}
        {%- if blog.articles.size == 0 -%}
          <p class="blog-page__empty">{{ 'blog.empty' | t }}</p>
        {%- else -%}
          <ul class="blog-page__grid blog-page__grid--{{ layout_style }}" role="list">
            {%- for article in blog.articles -%}
              {%- liquid
                assign is_featured = false
                if layout_style == 'featured' and forloop.first and paginate.current_page == 1
                  assign is_featured = true
                endif
              -%}
              <li class="blog-page__item{% if is_featured %} blog-page__item--featured{% endif %}">
                {% render 'article-card',
                  article: article,
                  featured: is_featured,
                  show_author: show_author,
                  show_date: show_date,
                  show_excerpt: show_excerpt,
                  show_tags: show_tags,
                  loading: forloop.first
                %}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="blog-page__pagination" aria-label="{{ 'general.pagination.label' | t }}">
              {{ paginate | default_pagination }}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .blog-page {
    --bp-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --bp-line: color-mix(in srgb, var(--color-heading) 10%, transparent);
    position: relative;
    display: block;
    color: var(--bp-text, var(--color-text));
    background: var(--bp-bg, var(--color-background));
  }

  .blog-page__atmosphere {
    display: none;
  }

  .blog-page__shell {
    position: relative;
    z-index: 1;
    padding-block: var(--bp-pad-top) var(--bp-pad-bottom);
  }

  .blog-page__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .blog-page__header {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
    max-width: 48rem;
  }

  .blog-page__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .blog-page__header--left {
    text-align: left;
    justify-items: start;
  }

  .blog-page__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bp-mute, var(--color-text-muted));
  }

  .blog-page__heading {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .blog-page__rule {
    display: block;
    width: 3rem;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .blog-page__header--center .blog-page__rule {
    margin-inline: auto;
  }

  .blog-page__subheading {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--bp-mute, var(--color-text-muted));
  }

  .blog-page__subheading p {
    margin: 0;
  }

  .blog-page__count {
    margin: 0.1rem 0 0;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bp-mute, var(--color-text-muted));
  }

  .blog-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    justify-content: flex-start;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--bp-line);
  }

  .blog-page__header--left + .blog-page__tags {
    justify-content: flex-start;
  }

  .blog-page__tag {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 650;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .blog-page__tag:hover,
  .blog-page__tag:focus-visible,
  .blog-page__tag.is-active {
    background: transparent;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45rem;
  }

  .blog-page__empty {
    margin: 0;
    padding: 3rem 1.5rem;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--bp-mute, var(--color-text-muted));
    border: 1px dashed color-mix(in srgb, var(--color-heading) 16%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-background) 55%, transparent);
  }

  .blog-page__grid {
    display: grid;
    grid-template-columns: repeat(var(--bp-cols-mobile), minmax(0, 1fr));
    gap: clamp(2rem, 4vw, var(--bp-gap));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-page__item {
    min-width: 0;
    display: flex;
  }

  .blog-page__item > * {
    width: 100%;
  }

  .blog-page__grid--featured .blog-page__item--featured {
    grid-column: 1 / -1;
  }

  @media (min-width: 750px) {
    .blog-page__grid {
      grid-template-columns: repeat(var(--bp-cols-tablet), minmax(0, 1fr));
      column-gap: var(--bp-gap);
      row-gap: clamp(2.75rem, 5vw, 4.5rem);
    }
  }

  @media (min-width: 990px) {
    .blog-page__grid {
      grid-template-columns: repeat(var(--bp-cols-desktop), minmax(0, 1fr));
    }
  }

  .blog-page__pagination {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .blog-page__pagination .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-page__pagination a,
  .blog-page__pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-heading) 12%, transparent);
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    background: var(--color-background);
  }

  .blog-page__pagination .current,
  .blog-page__pagination a:hover,
  .blog-page__pagination a:focus-visible {
    background: var(--color-button);
    border-color: var(--color-button);
    color: var(--color-button-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blog.name",
  "tag": "section",
  "class": "blog-page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.blog_heading_fallback"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Stories, styling notes, and behind-the-scenes from TAH.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_article_count",
      "label": "t:labels.show_article_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "t:labels.show_tag_filter",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.article"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:labels.posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:labels.layout_style",
      "default": "featured",
      "options": [
        { "value": "grid", "label": "t:options.layout.grid" },
        { "value": "featured", "label": "t:options.layout.spotlight" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "default": "16 / 10",
      "options": [
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "16 / 10", "label": "t:options.image_ratio.landscape" },
        { "value": "3 / 2", "label": "t:options.image_ratio.wide" }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "t:labels.columns_tablet",
      "default": "2",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:labels.corner_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:labels.card_background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:labels.muted_text",
      "default": "#6B6B6B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "enabled_on": {
    "templates": ["blog"]
  }
}
{% endschema %}
