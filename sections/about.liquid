{% render 'about-page', section: section, page_title: page.title %}

{% schema %}
{
  "name": "t:sections.about.name",
  "tag": "section",
  "class": "about-page-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "About Star Fabrics",
      "info": "t:info.about_heading_fallback"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Premium unstitched fabric and designer clothing from Jhelum (Dina City).</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:labels.story"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "t:labels.story_eyebrow",
      "default": "Star Fabrics"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "t:labels.story_heading",
      "default": "Premium fabrics. Timeless style."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "t:labels.story_text",
      "default": "<p>Star Fabrics is a trusted clothing brand committed to delivering quality, style, and comfort. We specialize in providing premium fabrics and fashionable designs that reflect modern trends while maintaining timeless elegance. Our focus on quality materials and fine craftsmanship ensures that every product meets the expectations of our valued customers.</p><p>With a passion for fashion and a dedication to excellence, Star Fabrics continues to grow as a reliable name in the clothing industry.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Shop collections"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    },
    {
      "type": "header",
      "content": "t:labels.mission_vision"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "t:labels.mission_heading",
      "default": "Our mission"
    },
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "t:labels.mission_text",
      "default": "Our mission is to provide high-quality clothing that combines comfort, durability, and contemporary style. We aim to build long-lasting relationships with our customers by offering exceptional value and consistent quality."
    },
    {
      "type": "text",
      "id": "vision_heading",
      "label": "t:labels.vision_heading",
      "default": "Our vision"
    },
    {
      "type": "textarea",
      "id": "vision_text",
      "label": "t:labels.vision_text",
      "default": "Our vision is to become a leading name in the fashion industry, recognized for innovation, trust, and excellence. We aspire to set new standards in clothing by continuously evolving with trends while staying true to our core values."
    },
    {
      "type": "header",
      "content": "t:labels.ceo_message"
    },
    {
      "type": "image_picker",
      "id": "ceo_image",
      "label": "t:labels.ceo_image",
      "info": "t:info.ceo_image"
    },
    {
      "type": "text",
      "id": "ceo_image_alt",
      "label": "t:labels.ceo_image_alt",
      "info": "t:info.ceo_image_alt"
    },
    {
      "type": "text",
      "id": "ceo_heading",
      "label": "t:labels.ceo_heading",
      "default": "CEO's message"
    },
    {
      "type": "textarea",
      "id": "ceo_text",
      "label": "t:labels.ceo_text",
      "default": "As the CEO of Star Fabrics, I am proud to lead a brand that stands for quality, integrity, and customer satisfaction. From fabric selection to final design, every step is guided by our commitment to excellence. Fashion is a reflection of confidence and individuality, and our goal is to deliver clothing that makes our customers feel comfortable, stylish, and confident. Thank you for trusting Star Fabrics and being part of our journey."
    },
    {
      "type": "text",
      "id": "ceo_name",
      "label": "t:labels.ceo_name",
      "default": "CEO, Star Fabrics"
    },
    {
      "type": "text",
      "id": "ceo_role",
      "label": "t:labels.ceo_role",
      "default": "CEO",
      "info": "t:info.ceo_role"
    },
    {
      "type": "header",
      "content": "t:labels.banner"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "t:labels.banner_heading",
      "default": "Ready to find your next piece?"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "t:labels.banner_text",
      "default": "Explore premium fabrics and designer clothing crafted for lasting beauty."
    },
    {
      "type": "text",
      "id": "banner_label",
      "label": "t:labels.banner_label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "t:labels.banner_link"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "t:labels.surface",
      "default": "#F7F7F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:labels.muted_text",
      "default": "#6B6B6B"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "t:sections.about.blocks.trust.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Money guarantee"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Within 7 days for an exchange."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.about.presets.name",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "title": "Money guarantee",
            "text": "Within 7 days for an exchange."
          }
        },
        {
          "type": "trust",
          "settings": {
            "title": "Online support",
            "text": "24 hours a day, 7 days a week."
          }
        },
        {
          "type": "trust",
          "settings": {
            "title": "World-wide delivery",
            "text": "Shipping available across Pakistan and beyond."
          }
        },
        {
          "type": "trust",
          "settings": {
            "title": "100% safe and secure",
            "text": "100% original products."
          }
        }
      ]
    }
  ]
}
{% endschema %}
