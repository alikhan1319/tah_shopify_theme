{%- liquid
  assign collection = section.settings.collection
  assign products_limit = section.settings.products_to_show

  assign link_url = section.settings.cta_link
  if link_url == blank and collection != blank
    assign link_url = collection.url
  endif

  assign cta_label = section.settings.link_label
  if cta_label == blank
    assign cta_label = section.settings.cta_label
  endif

  assign show_footer_cta = false
  if section.settings.show_cta and link_url != blank and cta_label != blank
    assign show_footer_cta = true
  endif
-%}

<div
  class="bridal-lehenga full-width"
  id="BridalLehenga-{{ section.id }}"
  style="
    --bl-padding-top: {{ section.settings.padding_top }}px;
    --bl-padding-bottom: {{ section.settings.padding_bottom }}px;
    --bl-cols-mobile: {{ section.settings.columns_mobile }};
    --bl-cols-tablet: {{ section.settings.columns_tablet }};
    --bl-cols-desktop: {{ section.settings.columns_desktop }};
    {%- if section.settings.use_theme_colors == false %}--bl-bg: {{ section.settings.background_color }};{% endif -%}
    --bl-gap: {{ section.settings.grid_gap }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="bridal-lehenga__shell">
    <div class="bridal-lehenga__inner">
      <header class="bridal-lehenga__header bridal-lehenga__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="bridal-lehenga__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="bridal-lehenga__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <span class="bridal-lehenga__rule" aria-hidden="true"></span>

        {%- if section.settings.subheading != blank -%}
          <div class="bridal-lehenga__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>

      {%- if collection == blank -%}
        {%- if request.design_mode -%}
          <p class="bridal-lehenga__empty">{{ 'sections.bridal_lehenga.empty_collection' | t }}</p>
        {%- endif -%}
      {%- elsif collection.products_count == 0 -%}
        {%- if request.design_mode -%}
          <p class="bridal-lehenga__empty">{{ 'sections.bridal_lehenga.no_products' | t }}</p>
        {%- endif -%}
      {%- else -%}
        <ul class="bridal-lehenga__grid" role="list" data-reveal-stagger>
          {%- for product in collection.products limit: products_limit -%}
            <li class="bridal-lehenga__item" data-reveal>
              {%- liquid
                assign card_loading = 'lazy'
                if forloop.index <= section.settings.columns_mobile
                  assign card_loading = 'eager'
                endif
              -%}
              {% render 'product-card',
                product: product,
                show_vendor: section.settings.show_vendor,
                show_description: section.settings.show_description,
                show_rating: section.settings.show_rating,
                show_quick_view: section.settings.show_quick_view,
                show_add_to_cart: section.settings.show_add_to_cart,
                loading: card_loading
              %}
            </li>
          {%- endfor -%}
        </ul>

        {%- if show_footer_cta -%}
          <div class="bridal-lehenga__footer">
            <a class="bridal-lehenga__cta" href="{{ link_url }}">
              {{ cta_label | escape }}
              <span class="bridal-lehenga__cta-icon" aria-hidden="true">→</span>
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .bridal-lehenga {
    --bl-ink: var(--color-heading);
    --bl-mute: var(--color-text-muted);
    --bl-line: var(--color-border);
    --bl-ease: cubic-bezier(0.22, 1, 0.36, 1);
    padding: 0;
    background: var(--bl-bg, var(--color-background));
    color: var(--bl-ink);
  }

  .bridal-lehenga__shell {
    padding-block: var(--bl-padding-top) var(--bl-padding-bottom);
  }

  .bridal-lehenga__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .bridal-lehenga__header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 40rem;
  }

  .bridal-lehenga__header--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .bridal-lehenga__header--left {
    text-align: left;
    justify-items: start;
  }

  .bridal-lehenga__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bl-mute);
  }

  .bridal-lehenga__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 550;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--bl-ink);
  }

  .bridal-lehenga__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--bl-ink);
    opacity: 0.85;
  }

  .bridal-lehenga__header--center .bridal-lehenga__rule {
    margin-inline: auto;
  }

  .bridal-lehenga__subheading {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--bl-mute);
  }

  .bridal-lehenga__subheading p {
    margin: 0;
  }

  .bridal-lehenga__empty {
    margin: 0;
    padding: 2.75rem 1.5rem;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--bl-mute);
    background: var(--color-background);
    border: 1px dashed var(--bl-line);
    border-radius: 12px;
  }

  .bridal-lehenga__grid {
    display: grid;
    grid-template-columns: repeat(var(--bl-cols-mobile), minmax(0, 1fr));
    gap: max(0.85rem, calc(var(--bl-gap) * 0.75));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bridal-lehenga__item {
    min-width: 0;
    display: flex;
  }

  .bridal-lehenga__item > * {
    width: 100%;
  }

  .bridal-lehenga__footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .bridal-lehenga__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 1.85rem;
    border: 1px solid var(--bl-ink);
    border-radius: 10px;
    background: transparent;
    color: var(--bl-ink);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms var(--bl-ease),
      gap 180ms var(--bl-ease);
  }

  .bridal-lehenga__cta:hover {
    background: var(--color-button);
    color: var(--color-button-text);
    transform: translateY(-1px);
    gap: 0.75rem;
  }

  .bridal-lehenga__cta-icon {
    font-size: 1em;
    line-height: 1;
  }

  @media (max-width: 479px) {
    .bridal-lehenga__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (min-width: 750px) {
    .bridal-lehenga__grid {
      grid-template-columns: repeat(var(--bl-cols-tablet), minmax(0, 1fr));
      gap: var(--bl-gap);
    }
  }

  @media (min-width: 990px) {
    .bridal-lehenga__grid {
      grid-template-columns: repeat(var(--bl-cols-desktop), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bridal-lehenga__cta {
      transition: none;
    }

    .bridal-lehenga__cta:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.bridal_lehenga.name",
  "tag": "section",
  "class": "bridal-lehenga-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Wedding edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Bridal lehenga collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Handcrafted lehengas for your most celebrated moments.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.call_to_action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "t:labels.show_cta",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Shop lehengas"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link",
      "info": "t:info.cta_link_collection"
    },
    {
      "type": "header",
      "content": "t:general.product"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:labels.show_rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "t:labels.show_quick_view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "t:labels.show_add_to_cart",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FAFAFA"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "t:labels.columns_tablet",
      "default": "2",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:sections.bridal_lehenga.presets.name",
      "settings": {
        "eyebrow": "Wedding edit",
        "heading": "Bridal lehenga collection",
        "subheading": "<p>Handcrafted lehengas for your most celebrated moments.</p>",
        "link_label": "View all",
        "show_cta": true,
        "cta_label": "Shop lehengas",
        "products_to_show": 8,
        "columns_mobile": "2",
        "columns_tablet": "2",
        "columns_desktop": 4,
        "background_color": "#FAFAFA"
      }
    }
  ]
}
{% endschema %}
