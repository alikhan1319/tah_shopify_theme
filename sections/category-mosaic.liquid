{%- liquid
  assign tile_count = section.blocks.size

  if tile_count == 5
    assign grid_class = 'category-mosaic__grid--mosaic'
  else
    assign grid_class = 'category-mosaic__grid--row'
  endif
-%}

<div
  class="category-mosaic full-width"
  style="
    --mosaic-padding-top: {{ section.settings.padding_top }}px;
    --mosaic-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mosaic-gap: {{ section.settings.grid_gap }}px;
    --mosaic-radius: {{ section.settings.corner_radius }}px;
    --mosaic-height: {{ section.settings.desktop_height }}px;
    --mosaic-count: {{ tile_count }};
  "
>
  <div class="category-mosaic__inner">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      align: 'center'
    %}

    {%- if tile_count > 0 -%}
      <ul class="category-mosaic__grid {{ grid_class }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_title = block.settings.title
            assign tile_link = block.settings.link
            assign tile_image = block.settings.image
            assign picked_collection = block.settings.collection

            if picked_collection != blank
              if tile_title == blank
                assign tile_title = picked_collection.title
              endif
              if tile_link == blank
                assign tile_link = picked_collection.url
              endif
              if tile_image == blank
                assign tile_image = picked_collection.featured_image
              endif
            endif

            assign image_sizes = '(min-width: 990px) 25vw, 50vw'
            if tile_count == 5
              case forloop.index
                when 1, 5
                  assign image_sizes = '(min-width: 990px) 30vw, 50vw'
                when 2
                  assign image_sizes = '(min-width: 990px) 40vw, 100vw'
                else
                  assign image_sizes = '(min-width: 990px) 20vw, 50vw'
              endcase
            endif
          -%}
          <li class="category-mosaic__item" {{ block.shopify_attributes }}>
            <a class="category-mosaic__tile" href="{{ tile_link | default: '#' }}">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1100, 1400',
                    sizes: image_sizes,
                    class: 'category-mosaic__image',
                    alt: '',
                    decoding: 'async'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'category-mosaic__placeholder' }}
              {%- endif -%}

              {%- if tile_title != blank -%}
                <span class="category-mosaic__label">{{ tile_title | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="category-mosaic__empty">{{ 'sections.category_mosaic.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .category-mosaic {
    padding-block: var(--mosaic-padding-top) var(--mosaic-padding-bottom);
    background: var(--color-background);
  }

  .category-mosaic__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .category-mosaic__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--mosaic-gap, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-mosaic__item {
    min-width: 0;
  }

  .category-mosaic__tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--mosaic-radius, 10px);
    background: var(--color-surface);
    color: var(--color-heading);
    text-decoration: none;
    isolation: isolate;
  }

  .category-mosaic__tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .category-mosaic__image,
  .category-mosaic__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-mosaic__image {
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .category-mosaic__placeholder {
    opacity: 0.45;
  }

  .category-mosaic__label {
    position: absolute;
    left: 50%;
    bottom: 0.85rem;
    z-index: 1;
    min-width: min(7.5rem, calc(100% - 1.5rem));
    max-width: calc(100% - 1.5rem);
    padding: 0.6rem 1.1rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-background);
    box-shadow: 0 6px 18px color-mix(in srgb, #000 8%, transparent);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    transform: translateX(-50%);
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }

  .category-mosaic__tile:hover .category-mosaic__image,
  .category-mosaic__tile:focus-visible .category-mosaic__image {
    transform: scale(1.05);
  }

  .category-mosaic__tile:hover .category-mosaic__label,
  .category-mosaic__tile:focus-visible .category-mosaic__label {
    background: var(--color-accent);
    color: var(--color-button-text);
  }

  /* Five tiles on mobile: two tall, one wide, two square */
  .category-mosaic__grid--mosaic > :nth-child(1) {
    grid-column: 1;
    grid-row: 1;
  }

  .category-mosaic__grid--mosaic > :nth-child(5) {
    grid-column: 2;
    grid-row: 1;
  }

  .category-mosaic__grid--mosaic > :nth-child(2) {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .category-mosaic__grid--mosaic > :nth-child(3) {
    grid-column: 1;
    grid-row: 3;
  }

  .category-mosaic__grid--mosaic > :nth-child(4) {
    grid-column: 2;
    grid-row: 3;
  }

  .category-mosaic__grid--mosaic > :nth-child(2) .category-mosaic__tile {
    aspect-ratio: 2 / 1;
  }

  .category-mosaic__grid--mosaic > :nth-child(3) .category-mosaic__tile,
  .category-mosaic__grid--mosaic > :nth-child(4) .category-mosaic__tile {
    aspect-ratio: 5 / 4;
  }

  .category-mosaic__empty {
    margin: 0;
    padding: 2.75rem 1.5rem;
    border-radius: var(--mosaic-radius, 10px);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 990px) {
    .category-mosaic__label {
      bottom: 1.1rem;
      min-width: min(8.5rem, calc(100% - 1.5rem));
      padding: 0.65rem 1.35rem;
      font-size: 0.85rem;
    }

    .category-mosaic__grid--row {
      grid-template-columns: repeat(var(--mosaic-count, 4), minmax(0, 1fr));
    }

    /* Five tiles on desktop: tall | wide over two squares | tall */
    .category-mosaic__grid--mosaic {
      grid-template-columns: 1.55fr 1fr 1fr 1.55fr;
      grid-template-rows: minmax(0, 2fr) minmax(0, 1fr);
      height: var(--mosaic-height, 460px);
    }

    /* :nth-child(n) matches the specificity of the mobile ratio rules above */
    .category-mosaic__grid--mosaic > :nth-child(n) .category-mosaic__tile {
      height: 100%;
      aspect-ratio: auto;
    }

    .category-mosaic__grid--mosaic > :nth-child(1) {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .category-mosaic__grid--mosaic > :nth-child(2) {
      grid-column: 2 / 4;
      grid-row: 1;
    }

    .category-mosaic__grid--mosaic > :nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }

    .category-mosaic__grid--mosaic > :nth-child(4) {
      grid-column: 3;
      grid-row: 2;
    }

    .category-mosaic__grid--mosaic > :nth-child(5) {
      grid-column: 4;
      grid-row: 1 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-mosaic__image,
    .category-mosaic__label {
      transition: none;
    }

    .category-mosaic__tile:hover .category-mosaic__image,
    .category-mosaic__tile:focus-visible .category-mosaic__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.category_mosaic",
  "tag": "section",
  "class": "category-mosaic-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:labels.section_height",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.category_mosaic",
      "blocks": [
        { "type": "tile", "settings": { "title": "Latest" } },
        { "type": "tile", "settings": { "title": "Summer" } },
        { "type": "tile", "settings": { "title": "Gents" } },
        { "type": "tile", "settings": { "title": "Sale" } },
        { "type": "tile", "settings": { "title": "Festive" } }
      ]
    }
  ]
}
{% endschema %}
