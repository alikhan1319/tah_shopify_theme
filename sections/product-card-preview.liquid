{%- liquid
  assign preview_collection = section.settings.collection
  assign products_limit = section.settings.products_to_show | default: 4
-%}

<div
  class="product-card-preview full-width"
  id="ProductCardPreview-{{ section.id }}"
  style="
    --pcp-padding-top: {{ section.settings.padding_top }}px;
    --pcp-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.use_theme_colors == false %}--pcp-bg: {{ section.settings.background_color }};{% endif -%}
    --pcp-columns: {{ section.settings.columns_desktop }};
  "
>
  <div class="product-card-preview__inner">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'center',
      class: 'product-card-preview__header'
    %}

    {%- if preview_collection == blank -%}
      {%- if request.design_mode -%}
        <p class="product-card-preview__empty">
          {{ 'sections.product_card_preview.empty_collection' | t }}
        </p>
      {%- endif -%}
    {%- elsif preview_collection.products_count == 0 -%}
      {%- if request.design_mode -%}
        <p class="product-card-preview__empty">
          {{ 'sections.product_card_preview.no_products' | t }}
        </p>
      {%- endif -%}
    {%- else -%}
      <ul class="product-card-preview__grid" role="list">
        {%- for product in preview_collection.products limit: products_limit -%}
          <li class="product-card-preview__item">
            {% render 'product-card',
              product: product,
              show_vendor: true,
              show_description: true,
              show_rating: true,
              loading: 'lazy'
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="product-card-preview__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-card-preview {
    background: var(--pcp-bg, var(--color-background));
    padding-block: var(--pcp-padding-top, 4rem) var(--pcp-padding-bottom, 4rem);
  }

  .product-card-preview__inner {
    width: min(
      calc(var(--page-width) - var(--page-margin) * 2),
      calc(100% - var(--page-margin) * 2)
    );
    margin-inline: auto;
  }

  .product-card-preview__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .product-card-preview__empty,
  .product-card-preview__note {
    margin: 1rem auto 0;
    max-width: 34rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  @media (min-width: 750px) {
    .product-card-preview__grid {
      grid-template-columns: repeat(var(--pcp-columns, 4), minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_card_preview",
  "tag": "section",
  "class": "product-card-preview-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "t:labels.use_theme_colors",
      "info": "t:info.use_theme_colors",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.product_card_preview_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Live preview"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Product cards from your store"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Real products from your catalog — hover to see image swap, wishlist, and Add to cart animation.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:labels.note",
      "default": "Prices show in your store currency (PKR). Set store currency to Pakistani Rupee in Shopify admin if needed."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:general.product_card_preview"
    }
  ]
}
{% endschema %}
