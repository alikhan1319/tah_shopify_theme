    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.85rem 0 0.15rem;
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 10%, var(--pp-line));
    background: transparent;
  }

  .pp__delivery strong {
    display: block;
    font-size: 0.8125rem;
    margin-bottom: 0.15rem;
  }

  .pp__delivery p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--pp-mute);
    line-height: 1.4;
  }

  .pp__payments p {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--pp-mute);
  }

  .pp__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .pp__payment-icons svg {
    height: 1.5rem;
    width: auto;
  }

  .pp__accordion { display: grid; gap: 0.55rem; }

  .pp__acc-item {
    border-radius: 16px;
    background: var(--color-background);
    border: 1px solid var(--pp-line);
    overflow: hidden;
  }

  .pp__acc-item summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.1rem;
    font-size: 0.925rem;
    font-weight: 750;
  }

  .pp__acc-item summary::-webkit-details-marker { display: none; }

  .pp__acc-body {
    padding: 0 1.1rem 1.1rem;
    font-size: 0.925rem;
    line-height: 1.7;
    color: var(--pp-mute);
  }

  /* Sticky */
  .pp__sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.75rem 0.9rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    border-top: 1px solid var(--pp-line);
    box-shadow: 0 -12px 32px color-mix(in srgb, var(--color-heading) 10%, transparent);
    backdrop-filter: blur(12px);
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    transition: transform 220ms var(--pp-ease), opacity 220ms ease;
  }

  .pp__sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .pp__sticky[hidden] { display: block !important; }

  .pp__lightbox {
    position: fixed;
    inset: 0;
    z-index: 130;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }

  .pp__lightbox[hidden] {
    display: none !important;
  }

  .pp__lightbox-overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-heading) 72%, #000);
  }

  .pp__lightbox-dialog {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: min(960px, calc(100% - 6rem));
    max-height: calc(100vh - 2.5rem);
  }

  .pp__lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(100vh - 6.5rem);
    object-fit: contain;
    border-radius: 18px;
    background: var(--color-background);
    box-shadow: 0 24px 60px color-mix(in srgb, #000 28%, transparent);
  }

  .pp__lightbox-close,
  .pp__lightbox-nav {
    appearance: none;
    position: absolute;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: var(--color-background);
    color: var(--color-heading);
    cursor: pointer;
    box-shadow: 0 10px 24px color-mix(in srgb, #000 18%, transparent);
  }

  .pp__lightbox-close {
    top: 1rem;
    right: 1rem;
    width: 2.6rem;
    height: 2.6rem;
    z-index: 2;
  }

  .pp__lightbox-close svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .pp__lightbox-nav {
    top: 50%;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.6rem;
    line-height: 1;
    transform: translateY(-50%);
  }

  .pp__lightbox-nav--prev { left: 1rem; }
  .pp__lightbox-nav--next { right: 1rem; }

  .pp__lightbox-close:hover,
  .pp__lightbox-nav:hover,
  .pp__lightbox-close:focus-visible,
  .pp__lightbox-nav:focus-visible {
    background: var(--color-accent);
    color: var(--color-button-text);
  }

  .pp__lightbox-count {
    position: static;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    color: var(--color-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .pp__lightbox-nav[hidden] {
    display: none !important;
  }

  body.is-lightbox-open {
    overflow: hidden;
  }

  @media (max-width: 749px) {
    .pp__lightbox {
      padding: 0.75rem;
    }

    .pp__lightbox-nav {
      width: 2.4rem;
      height: 2.4rem;
    }

    .pp__lightbox-nav--prev { left: 0.35rem; }
    .pp__lightbox-nav--next { right: 0.35rem; }
  }

  .pp__sticky-inner {
    width: min(1280px, calc(100% - 0.5rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    align-items: center;
  }

  .pp__sticky-title {
    margin: 0 0 0.15rem;
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pp__sticky-price-row {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    font-weight: 800;
  }

  .pp__sticky-price-row s {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--pp-mute);
  }

  .pp__sticky-actions {
    display: grid;
    grid-auto-flow: column;
    gap: 0.5rem;
  }

  .pp__sticky-atc,
  .pp__sticky-buy {
    appearance: none;
    min-height: 2.85rem;
    padding: 0 1rem;
    border-radius: 14px;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 750;
    cursor: pointer;
  }

  .pp__sticky-atc {
    border: 0;
    background: var(--color-button);
    color: var(--color-button-text);
  }

  .pp__sticky-buy {
    border: 1px solid var(--color-heading);
    background: var(--color-background);
    color: var(--color-heading);
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (min-width: 990px) {
    .pp__grid {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
      gap: 4rem;
      align-items: start;
    }

    .pp__gallery {
      position: sticky;
      top: 5.75rem;
    }

    .pp__buybox { gap: 1rem; }
  }

  @media (max-width: 989px) {
    .pp__features,
    .pp__trust,
    .pp__delivery {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 749px) {
    .pp__shell { width: min(100% - 1.25rem, 1280px); }

    .pp__features,
    .pp__delivery {
      grid-template-columns: 1fr;
    }

    .pp__sticky-inner {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .pp__sticky-actions {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
    }

    .pp__sticky-meta {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      align-items: baseline;
    }

    .pp__sticky-title { margin: 0; flex: 1; min-width: 0; }
  }

  @media (min-width: 750px) {
    .pp__sticky {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp__main-img,
    .pp__thumb,
    .pp__feature,
    .pp__atc,
    .pp__buy,
    .pp__wa,
    .pp__sticky {
      transition: none;
    }

    .pp__zoom:hover .pp__main-img { transform: none; }

    .pp__trust-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      gap: 0.5rem;
    }

    .pp__trust-group:not(:first-child),
    .pp__trust-group[aria-hidden='true'] {
      display: none;
    }

    .pp__trust-marquee {
      mask-image: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class TahProductPage extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;

      this.addLabel = this.dataset.addLabel || 'Add to cart';
      this.soldOutLabel = this.dataset.soldOutLabel || 'Sold out';
      this.cartAddUrl = this.dataset.cartAddUrl;
      this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';

      this.form = this.querySelector('[data-product-form]');
      this.variantInput = this.querySelector('[data-variant-input]');
      this.atcBtn = this.querySelector('[data-add-to-cart]');
      this.atcLabel = this.querySelector('[data-atc-label]');
      this.buyBtn = this.querySelector('[data-buy-now]');
      this.priceEl = this.querySelector('[data-price]');
      this.compareEl = this.querySelector('[data-compare]');
      this.discountEl = this.querySelector('[data-discount]');
      this.saveEl = this.querySelector('[data-save]');
      this.saleBadge = this.querySelector('[data-sale-badge]');
      this.availability = this.querySelector('[data-availability]');
      this.availabilityText = this.querySelector('[data-availability-text]');
      this.mainImage = this.querySelector('[data-main-image]');
      this.optionsRoot = this.querySelector('[data-options]');
      this.qtyInput = this.querySelector('[data-qty-input]');
      this.gallery = this.querySelector('[data-gallery]');
      this.thumbs = this.querySelector('[data-thumbs]');
      this.actionsAnchor = this.querySelector('[data-actions-anchor]');
      this.stickyBar = this.querySelector('[data-sticky-bar]');
      this.stickyAtc = this.querySelector('[data-sticky-atc]');
      this.stickyAtcLabel = this.querySelector('[data-sticky-atc-label]');
      this.stickyBuy = this.querySelector('[data-sticky-buy]');
      this.stickyPrice = this.querySelector('[data-sticky-price]');
      this.stickyCompare = this.querySelector('[data-sticky-compare]');
      this.stage = this.querySelector('[data-stage]');
      this.lightbox = this.querySelector('[data-lightbox]');
      this.lightboxImage = this.querySelector('[data-lightbox-image]');
      this.lightboxCount = this.querySelector('[data-lightbox-count]');

      try {
        this.galleryImages = JSON.parse(this.querySelector('[data-gallery-json]')?.textContent || '[]');
      } catch (e) {
        this.galleryImages = [];
      }
      this.lightboxIndex = 0;

      try {
        this.product = JSON.parse(this.querySelector('[data-product-json]')?.textContent || '{}');
      } catch (e) {
        this.product = { variants: [], options: [] };
      }

      const currentId = Number(this.variantInput?.value);
      const current = this.product.variants?.find((v) => v.id === currentId) || this.product.variants?.[0];
      this.selectedOptions = [
        current?.option1 || null,
        current?.option2 || null,
        current?.option3 || null,
      ].slice(0, (this.product.options || []).length);

      this.onOptionClick = (event) => {
        const button = event.target.closest('[data-option-value]');
        if (!button || !this.optionsRoot?.contains(button)) return;
        const fieldset = button.closest('[data-option-index]');
        const index = Number(fieldset?.dataset.optionIndex);
        if (Number.isNaN(index)) return;
        this.selectedOptions[index] = button.dataset.optionValue;
        const label = fieldset.querySelector('[data-selected-label]');
        if (label) label.textContent = button.dataset.optionValue;
        this.renderOptions();
        this.syncVariant();
      };

      this.onGalleryClick = (event) => {
        const thumb = event.target.closest('[data-thumb]');
        if (!thumb || !this.gallery?.contains(thumb)) return;
        event.preventDefault();
        this.selectThumb(thumb);
      };

      this.onSubmit = (event) => {
        event.preventDefault();
        this.addToCart(false);
      };

      this.onBuyNow = () => this.addToCart(true);
      this.onStickyAtc = () => this.addToCart(false);
      this.onStickyBuy = () => this.addToCart(true);
      this.onQtyMinus = () => this.setQty(-1);
      this.onQtyPlus = () => this.setQty(1);
      this.onThumbPrev = () => this.thumbs?.scrollBy({ left: -160, behavior: 'smooth' });
      this.onThumbNext = () => this.thumbs?.scrollBy({ left: 160, behavior: 'smooth' });
      this.onStageClick = (event) => {
        if (event.target.closest('[data-thumb], [data-thumb-prev], [data-thumb-next]')) return;
        if (this.stage?.classList.contains('is-video')) return;
        if (!event.target.closest('[data-zoom], [data-main-image]')) return;
        this.openLightbox();
      };
      this.onLightboxClick = (event) => {
        if (event.target.closest('[data-lightbox-close]')) {
          this.closeLightbox();
          return;
        }
        if (event.target.closest('[data-lightbox-prev]')) {
          this.stepLightbox(-1);
          return;
        }
        if (event.target.closest('[data-lightbox-next]')) {
          this.stepLightbox(1);
        }
      };
      this.onLightboxKey = (event) => {
        if (this.lightbox?.hidden) return;
        if (event.key === 'Escape') this.closeLightbox();
        if (event.key === 'ArrowLeft') this.stepLightbox(-1);
        if (event.key === 'ArrowRight') this.stepLightbox(1);
      };
      this.onLightboxTouchStart = (event) => {
        this._lbStartX = event.changedTouches?.[0]?.clientX || 0;
      };
      this.onLightboxTouchEnd = (event) => {
        if (this.lightbox?.hidden) return;
        const endX = event.changedTouches?.[0]?.clientX || 0;
        const delta = endX - (this._lbStartX || 0);
        if (Math.abs(delta) < 50) return;
        this.stepLightbox(delta < 0 ? 1 : -1);
      };

      this.optionsRoot?.addEventListener('click', this.onOptionClick);
      this.gallery?.addEventListener('click', this.onGalleryClick);
      this.form?.addEventListener('submit', this.onSubmit);
      this.buyBtn?.addEventListener('click', this.onBuyNow);
      this.stickyAtc?.addEventListener('click', this.onStickyAtc);
      this.stickyBuy?.addEventListener('click', this.onStickyBuy);
      this.querySelector('[data-qty-minus]')?.addEventListener('click', this.onQtyMinus);
      this.querySelector('[data-qty-plus]')?.addEventListener('click', this.onQtyPlus);
      this.querySelector('[data-thumb-prev]')?.addEventListener('click', this.onThumbPrev);
      this.querySelector('[data-thumb-next]')?.addEventListener('click', this.onThumbNext);
      this.stage?.addEventListener('click', this.onStageClick);
      this.lightbox?.addEventListener('click', this.onLightboxClick);
      this.lightbox?.addEventListener('touchstart', this.onLightboxTouchStart, { passive: true });
      this.lightbox?.addEventListener('touchend', this.onLightboxTouchEnd, { passive: true });
      document.addEventListener('keydown', this.onLightboxKey);

      this.setupSwipe();
      this.setupStickyBar();

      if (this.dataset.hasVariants === 'true') {
        this.renderOptions();
        this.syncVariant();
      }
    }

    disconnectedCallback() {
      this.optionsRoot?.removeEventListener('click', this.onOptionClick);
      this.gallery?.removeEventListener('click', this.onGalleryClick);
      this.form?.removeEventListener('submit', this.onSubmit);
      this.buyBtn?.removeEventListener('click', this.onBuyNow);
      this.stickyAtc?.removeEventListener('click', this.onStickyAtc);
      this.stickyBuy?.removeEventListener('click', this.onStickyBuy);
      this.querySelector('[data-qty-minus]')?.removeEventListener('click', this.onQtyMinus);
      this.querySelector('[data-qty-plus]')?.removeEventListener('click', this.onQtyPlus);
      this.querySelector('[data-thumb-prev]')?.removeEventListener('click', this.onThumbPrev);
      this.querySelector('[data-thumb-next]')?.removeEventListener('click', this.onThumbNext);
      this.stage?.removeEventListener('click', this.onStageClick);
      this.lightbox?.removeEventListener('click', this.onLightboxClick);
      this.lightbox?.removeEventListener('touchstart', this.onLightboxTouchStart);
      this.lightbox?.removeEventListener('touchend', this.onLightboxTouchEnd);
      document.removeEventListener('keydown', this.onLightboxKey);
      document.body.classList.remove('is-lightbox-open');
      this.stickyObserver?.disconnect();
      if (this.stage && this._onTouchStart) {
        this.stage.removeEventListener('touchstart', this._onTouchStart);
        this.stage.removeEventListener('touchend', this._onTouchEnd);
      }
    }

    openLightbox() {
      if (!this.lightbox || !this.galleryImages.length) return;
      const activeId = this.querySelector('[data-thumb].is-active')?.getAttribute('data-media-id');
      let index = this.galleryImages.findIndex((item) => String(item.id) === String(activeId));
      if (index < 0) index = 0;
      this.lightboxIndex = index;
      this.renderLightbox();
      this.lightbox.hidden = false;
      document.body.classList.add('is-lightbox-open');
      this.lightbox.querySelector('[data-lightbox-dialog]')?.focus();
    }

    closeLightbox() {
      if (!this.lightbox) return;
      this.lightbox.hidden = true;
      document.body.classList.remove('is-lightbox-open');
    }

    stepLightbox(step) {
      if (!this.galleryImages.length) return;
      const total = this.galleryImages.length;
      this.lightboxIndex = (this.lightboxIndex + step + total) % total;
      this.renderLightbox();
    }

    renderLightbox() {
      const item = this.galleryImages[this.lightboxIndex];
      if (!item || !this.lightboxImage) return;
      this.lightboxImage.src = item.src;
      this.lightboxImage.alt = item.alt || '';
      if (this.lightboxCount) {
        const template = this.lightbox?.dataset.countTemplate || '__INDEX__ / __COUNT__';
        this.lightboxCount.textContent = template
          .replace('__INDEX__', String(this.lightboxIndex + 1))
          .replace('__COUNT__', String(this.galleryImages.length));
      }
      const many = this.galleryImages.length > 1;
      this.querySelector('[data-lightbox-prev]')?.toggleAttribute('hidden', !many);
      this.querySelector('[data-lightbox-next]')?.toggleAttribute('hidden', !many);
    }

    selectThumb(thumb) {
      if (!thumb) return;
      this.setActiveThumb(thumb);
      this.showMedia(thumb.getAttribute('data-media-id'), thumb.getAttribute('data-media-type'));
    }

    showMedia(mediaId, mediaType) {
      if (!mediaId) return;
      const host = this.querySelector('[data-media-host]');
      const template = this.querySelector(`[data-media-template="${mediaId}"]`);
      if (!host || !template) return;

      this.pauseActiveMedia();
      host.classList.remove('is-loaded');
      host.removeAttribute('data-skeleton-ready');
      delete host.dataset.skeletonBound;
      host.setAttribute('data-skeleton', '');
      host.replaceChildren(template.content.cloneNode(true));

      const type = mediaType || template.getAttribute('data-media-type') || 'image';
      this.stage?.classList.toggle('is-video', type === 'video' || type === 'external_video');
      this.mainImage = this.querySelector('[data-main-image]');

      const video = host.querySelector('video');
      if (video) {
        video.muted = true;
        video.setAttribute('playsinline', '');
        const playPromise = video.play?.();
        if (playPromise?.catch) playPromise.catch(() => {});
      }

      if (window.TahReveal?.initSkeletons) {
        window.TahReveal.initSkeletons(host.parentElement || this);
      }
    }

    pauseActiveMedia() {
      this.querySelectorAll('[data-media-host] video').forEach((video) => {
        try {
          video.pause();
          video.currentTime = 0;
        } catch (e) {}
      });
    }

    setupSwipe() {
      if (!this.stage) return;
      let startX = 0;
      this._onTouchStart = (e) => {
        startX = e.changedTouches?.[0]?.clientX || 0;
      };
      this._onTouchEnd = (e) => {
        const endX = e.changedTouches?.[0]?.clientX || 0;
        const delta = endX - startX;
        if (Math.abs(delta) < 40) return;
        const thumbs = [...this.querySelectorAll('[data-thumb]')];
        const activeIndex = thumbs.findIndex((t) => t.classList.contains('is-active'));
        if (activeIndex < 0) return;
        const next = delta < 0 ? thumbs[activeIndex + 1] : thumbs[activeIndex - 1];
        if (!next) return;
        this.selectThumb(next);
        next.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      };
      this.stage.addEventListener('touchstart', this._onTouchStart, { passive: true });
      this.stage.addEventListener('touchend', this._onTouchEnd, { passive: true });
    }

    setupStickyBar() {
      if (!this.stickyBar || !this.actionsAnchor || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(min-width: 750px)').matches) return;

      this.stickyObserver = new IntersectionObserver(
        ([entry]) => {
          const show = !entry.isIntersecting;
          this.stickyBar.classList.toggle('is-visible', show);
          this.stickyBar.hidden = !show;
        },
        { threshold: 0, rootMargin: '0px 0px -8px 0px' }
      );
      this.stickyObserver.observe(this.actionsAnchor);
    }

    setQty(delta) {
      if (!this.qtyInput) return;
      this.qtyInput.value = String(Math.max(1, Number(this.qtyInput.value || 1) + delta));
    }

    findVariant(options) {
      return (this.product.variants || []).find((variant) =>
        options.every((value, index) => !value || variant[`option${index + 1}`] === value)
      );
    }

    isValueSoldOut(optionIndex, value) {
      const probe = [...this.selectedOptions];
      probe[optionIndex] = value;
      const matches = (this.product.variants || []).filter((variant) =>
        probe.every((selected, index) => !selected || variant[`option${index + 1}`] === selected)
      );
      return !matches.length || matches.every((variant) => !variant.available);
    }

    renderOptions() {
      this.optionsRoot?.querySelectorAll('[data-option-index]').forEach((fieldset) => {
        const index = Number(fieldset.dataset.optionIndex);
        const selected = this.selectedOptions[index] || '';
        fieldset.querySelectorAll('[data-option-value]').forEach((button) => {
          const value = button.dataset.optionValue;
          button.classList.toggle('is-selected', value === selected);
          button.classList.toggle('is-soldout', this.isValueSoldOut(index, value));
          button.setAttribute('aria-pressed', String(value === selected));
        });
      });
    }

    syncVariant() {
      const variant = this.findVariant(this.selectedOptions);
      if (!variant) {
        if (this.variantInput) this.variantInput.value = '';
        this.setPurchaseState(false);
        return;
      }

      if (this.variantInput) this.variantInput.value = String(variant.id);
      const formattedPrice = this.formatMoney(variant.price);
      if (this.priceEl) this.priceEl.textContent = formattedPrice;
      if (this.stickyPrice) this.stickyPrice.textContent = formattedPrice;

      const onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
      if (this.compareEl) {
        this.compareEl.hidden = !onSale;
        if (onSale) this.compareEl.textContent = this.formatMoney(variant.compare_at_price);
      }
      if (this.stickyCompare) {
        this.stickyCompare.hidden = !onSale;
        if (onSale) this.stickyCompare.textContent = this.formatMoney(variant.compare_at_price);
      }

      if (this.discountEl) {
        if (onSale && variant.price > 0) {
          const percent = Math.round(((variant.compare_at_price - variant.price) * 100) / variant.compare_at_price);
          this.discountEl.hidden = false;
          this.discountEl.textContent = `${percent}% OFF`;
          if (this.saleBadge) {
            this.saleBadge.hidden = false;
            this.saleBadge.textContent = `${percent}% OFF`;
          }
        } else {
          this.discountEl.hidden = true;
          if (this.saleBadge) this.saleBadge.hidden = true;
        }
      }

      if (this.saveEl) {
        if (onSale) {
          this.saveEl.hidden = false;
          this.saveEl.textContent = `Save ${this.formatMoney(variant.compare_at_price - variant.price)}`;
        } else {
          this.saveEl.hidden = true;
        }
      }

      if (variant.featured_media_id) {
        const thumb = this.querySelector(`[data-thumb][data-media-id="${variant.featured_media_id}"]`);
        if (thumb) {
          this.selectThumb(thumb);
        } else {
          this.showMedia(String(variant.featured_media_id));
        }
      }

      this.setPurchaseState(variant.available);
    }

    setPurchaseState(available) {
      const label = available ? this.addLabel : this.soldOutLabel;
      const buttons = [this.atcBtn, this.buyBtn, this.stickyAtc, this.stickyBuy];
      buttons.forEach((btn) => {
        if (!btn) return;
        if (available) btn.removeAttribute('disabled');
        else btn.setAttribute('disabled', '');
      });
      if (this.atcLabel) this.atcLabel.textContent = label;
      if (this.stickyAtcLabel) this.stickyAtcLabel.textContent = label;
      if (this.availability) this.availability.classList.toggle('is-out', !available);
      if (this.availabilityText) this.availabilityText.textContent = available ? 'In stock' : this.soldOutLabel;
    }

    setActiveThumb(active) {
      this.querySelectorAll('[data-thumb]').forEach((thumb) => {
        const on = thumb === active;
        thumb.classList.toggle('is-active', on);
        thumb.setAttribute('aria-pressed', String(on));
      });
    }

    setMainImage(src, alt, srcset, sizes) {
      if (!src) return;
      if (!this.mainImage) {
        this.mainImage = this.querySelector('[data-main-image]');
      }
      if (!this.mainImage) return;

      this.mainImage.style.opacity = '0.4';
      this.mainImage.setAttribute('src', src);
      this.mainImage.src = src;

      if (srcset) {
        this.mainImage.setAttribute('srcset', srcset);
        this.mainImage.srcset = srcset;
      } else {
        this.mainImage.removeAttribute('srcset');
      }

      if (sizes) {
        this.mainImage.setAttribute('sizes', sizes);
        this.mainImage.sizes = sizes;
      } else {
        this.mainImage.setAttribute('sizes', '(min-width: 990px) 52vw, 100vw');
      }

      if (alt) this.mainImage.alt = alt;

      const reveal = () => {
        this.mainImage.style.opacity = '1';
      };

      if (this.mainImage.complete) {
        requestAnimationFrame(reveal);
      } else {
        this.mainImage.addEventListener('load', reveal, { once: true });
        this.mainImage.addEventListener('error', reveal, { once: true });
      }
    }

    async addToCart(checkout) {
      if (!this.atcBtn || this.atcBtn.disabled || !this.cartAddUrl) return;
      const id = Number(this.variantInput?.value);
      const quantity = Math.max(1, Number(this.qtyInput?.value || 1));
      if (!id) return;

      const cartDrawer = document.querySelector('cart-drawer');
      const sectionId = cartDrawer?.dataset.sectionId;
      [this.atcBtn, this.buyBtn, this.stickyAtc, this.stickyBuy].forEach((btn) => btn?.classList.add('is-loading'));

      try {
        const payload = { items: [{ id, quantity }] };
        if (sectionId && !checkout) {
          payload.sections = sectionId;
          payload.sections_url = window.location.pathname;
        }
        const response = await fetch(this.cartAddUrl, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.description || 'Add to cart failed');
        if (checkout) {
          window.location.href = '/checkout';
          return;
        }
        document.dispatchEvent(
          new CustomEvent('cart:refresh', {
            detail: { open: true, sections: data.sections, itemCount: data.item_count, cart: data },
          })
        );
      } catch (error) {
        console.error(error);
      } finally {
        [this.atcBtn, this.buyBtn, this.stickyAtc, this.stickyBuy].forEach((btn) => btn?.classList.remove('is-loading'));
      }
    }

    formatMoney(cents) {
      if (window.Shopify?.formatMoney) return window.Shopify.formatMoney(cents, this.moneyFormat);
      const amount = (Number(cents) / 100).toFixed(2);
      return this.moneyFormat
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
        .replace(/\{\{\s*amount\s*\}\}/g, amount);
    }
  }

  if (!customElements.get('tah-product-page')) {
    customElements.define('tah-product-page', TahProductPage);
  }
{% endjavascript %}

