{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign has_variants = false
  unless product.has_only_default_variant
    assign has_variants = true
  endunless

  assign compare = current_variant.compare_at_price
  assign price = current_variant.price
  assign on_sale = false
  if compare != blank and compare > price
    assign on_sale = true
  endif

  assign discount_percent = 0
  assign save_amount = 0
  if on_sale and price > 0
    assign discount_percent = compare | minus: price | times: 100.0 | divided_by: compare | round
    assign save_amount = compare | minus: price
  endif

  assign short_desc = section.settings.short_description
  if short_desc == blank and product.description != blank
    assign short_desc = product.description | strip_html | truncate: 180
  endif

  assign rating_metafield = product.metafields.reviews.rating
  assign rating_count_metafield = product.metafields.reviews.rating_count
  assign card_rating = blank
  assign card_rating_count = blank
  assign has_real_rating = false

  if rating_metafield.value.rating != blank
    assign card_rating = rating_metafield.value.rating | times: 1.0
    assign has_real_rating = true
  elsif rating_metafield.value != blank
    assign card_rating = rating_metafield.value | times: 1.0
    assign has_real_rating = true
  endif

  if rating_count_metafield.value != blank
    assign card_rating_count = rating_count_metafield.value
    assign has_real_rating = true
  endif

  if card_rating == blank and section.settings.show_rating
    assign rating_seed = product.id | modulo: 8
    assign card_rating = 42 | plus: rating_seed | times: 1.0 | divided_by: 10.0
    assign card_rating_count = product.id | modulo: 167 | plus: 28
  endif

  assign share_url = shop.url | append: product.url
  assign product_image_url = blank
  if featured_media != blank
    assign product_image_url = featured_media.preview_image | image_url: width: 400
  endif
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'

  assign whatsapp_digits = section.settings.whatsapp_number | default: '' | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign whatsapp_message = section.settings.whatsapp_message | default: 'Hi, I want to order:'
  assign whatsapp_href = blank
  if whatsapp_digits != blank
    assign whatsapp_text = whatsapp_message | append: ' ' | append: product.title | append: ' — ' | append: share_url
    assign whatsapp_text_encoded = whatsapp_text | url_param_escape
    assign whatsapp_href = 'https://wa.me/' | append: whatsapp_digits | append: '?text=' | append: whatsapp_text_encoded
  endif
-%}

<tah-product-page
  class="pp full-width"
  id="ProductPage-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url }}"
  data-product-image="{{ product_image_url }}"
  data-product-price="{{ current_variant.price | money }}"
  data-share-url="{{ share_url | escape }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-add-label="{{ 'products.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.sold_out' | t | escape }}"
  data-has-variants="{{ has_variants }}"
  style="
    {%- if section.settings.use_theme_colors == false %}--pp-bg: {{ section.settings.color_background }};{% endif -%}
    --pp-pad-t: {{ section.settings.padding_top }}px;
    --pp-pad-b: {{ section.settings.padding_bottom }}px;
    --pp-accent: {{ section.settings.accent_color | default: settings.color_accent }};
    --pp-ink: {{ settings.color_text }};
    --pp-black: {{ settings.color_button }};
    --pp-mute: {{ settings.color_text_muted }};
    --pp-line: {{ settings.color_border }};
    --pp-btn-text: {{ settings.color_button_text }};
    --pp-btn-hover: {{ settings.color_button_hover }};
  "
  {{ section.shopify_attributes }}
>
  <div class="pp__shell">
    <div class="pp__grid">
      {%- comment -%} LEFT: Gallery {%- endcomment -%}
      <div class="pp__gallery" data-gallery data-reveal>
        <div class="pp__stage{% if featured_media.media_type == 'video' or featured_media.media_type == 'external_video' %} is-video{% endif %}" data-stage>
          <div class="pp__media-host" data-media-host data-skeleton>
            {%- if featured_media != blank -%}
              {%- case featured_media.media_type -%}
                {%- when 'video' -%}
                  {{
                    featured_media
                    | video_tag:
                      class: 'pp__main-video',
                      controls: true,
                      muted: true,
                      playsinline: true,
                      preload: 'metadata',
                      image_size: '2400x'
                  }}
                {%- when 'external_video' -%}
                  {{
                    featured_media
                    | external_video_tag:
                      class: 'pp__main-video pp__main-video--external',
                      loading: 'eager'
                  }}
                {%- else -%}
                  {%- assign main_alt = featured_media.alt | default: product.title -%}
                  <div class="pp__zoom" data-zoom>
                    {{
                      featured_media.preview_image
                      | image_url: width: 2400
                      | image_tag:
                        class: 'pp__main-img',
                        loading: 'eager',
                        fetchpriority: 'high',
                        widths: '800, 1200, 1600, 2000, 2400',
                        sizes: '(min-width: 990px) 52vw, 100vw',
                        alt: main_alt,
                        data-main-image: true,
                        data-skeleton-img: true
                    }}
                  </div>
                {%- endcase -%}
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'pp__placeholder' }}
            {%- endif -%}
          </div>

          {%- if on_sale -%}
            <span class="pp__badge-sale" data-sale-badge>{{ discount_percent }}% OFF</span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 0 -%}
          <div class="pp__media-templates" hidden>
            {%- for media in product.media -%}
              <template data-media-template="{{ media.id }}" data-media-type="{{ media.media_type }}">
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{
                      media
                      | video_tag:
                        class: 'pp__main-video',
                        controls: true,
                        muted: true,
                        playsinline: true,
                        preload: 'metadata',
                        image_size: '2400x'
                    }}
                  {%- when 'external_video' -%}
                    {{
                      media
                      | external_video_tag:
                        class: 'pp__main-video pp__main-video--external'
                    }}
                  {%- else -%}
                    {%- assign media_alt = media.alt | default: product.title -%}
                    <div class="pp__zoom" data-zoom>
                      {{
                        media.preview_image
                        | image_url: width: 2400
                        | image_tag:
                          class: 'pp__main-img',
                          loading: 'eager',
                          widths: '800, 1200, 1600, 2000, 2400',
                          sizes: '(min-width: 990px) 52vw, 100vw',
                          alt: media_alt,
                          data-main-image: true,
                          data-skeleton-img: true
                      }}
                    </div>
                  {%- endcase -%}
              </template>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <div class="pp__thumbs-wrap">
            <button type="button" class="pp__thumb-nav pp__thumb-nav--prev" data-thumb-prev aria-label="{{ 'accessibility.previous_slide' | t }}">‹</button>
            <ul class="pp__thumbs" role="list" data-thumbs>
              {%- for media in product.media -%}
                {%- liquid
                  assign is_video_media = false
                  if media.media_type == 'video' or media.media_type == 'external_video'
                    assign is_video_media = true
                  endif
                -%}
                <li>
                  <button
                    type="button"
                    class="pp__thumb{% if media.id == featured_media.id %} is-active{% endif %}{% if is_video_media %} pp__thumb--video{% endif %}"
                    data-thumb
                    data-media-id="{{ media.id }}"
                    data-media-type="{{ media.media_type }}"
                    aria-label="{% if is_video_media %}{{ 'accessibility.video_of' | t: index: forloop.index, count: product.media.size }}{% else %}{{ 'accessibility.image_of' | t: index: forloop.index, count: product.media.size }}{% endif %}"
                    aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                  >
                    <img
                      class="pp__thumb-img"
                      src="{{ media.preview_image | image_url: width: 320 }}"
                      srcset="{{ media.preview_image | image_url: width: 160 }} 160w, {{ media.preview_image | image_url: width: 320 }} 320w"
                      sizes="72px"
                      alt="{{ media.alt | default: product.title | escape }}"
                      width="320"
                      height="400"
                      loading="lazy"
                    >
                    {%- if is_video_media -%}
                      <span class="pp__thumb-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
                          <path d="M8 5.14v13.72L19 12 8 5.14z"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            <button type="button" class="pp__thumb-nav pp__thumb-nav--next" data-thumb-next aria-label="{{ 'accessibility.next_slide' | t }}">›</button>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT: Buy box {%- endcomment -%}
      <div class="pp__buybox" data-reveal>
        <nav class="pp__crumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
          <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
          <span aria-hidden="true">/</span>
          {%- if product.collections.first != blank -%}
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
          {%- else -%}
            <a href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
          {%- endif -%}
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ product.title | escape | truncate: 28 }}</span>
        </nav>

        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <p class="pp__brand">{{ product.vendor | escape }}</p>
        {%- endif -%}

        <h1 class="pp__title">{{ product.title | escape }}</h1>

        <div class="pp__meta">
          {%- if section.settings.show_rating and card_rating != blank -%}
            <div
              class="pp__rating"
              role="img"
              aria-label="{{ 'products.rating_aria' | t: rating: card_rating, count: card_rating_count }}"
            >
              <span class="pp__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <span class="{% if i <= card_rating %}is-on{% endif %}">★</span>
                {%- endfor -%}
              </span>
              <strong>{{ card_rating | round: 1 }}</strong>
              {%- if card_rating_count != blank -%}
                <span class="pp__reviews-count">({{ card_rating_count }})</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_verified and has_real_rating -%}
            <span class="pp__verified">{{ 'products.verified_reviews' | t }}</span>
          {%- endif -%}

          <div class="pp__availability{% unless current_variant.available %} is-out{% endunless %}" data-availability>
            <span class="pp__avail-dot" aria-hidden="true"></span>
            <span data-availability-text>
              {%- if current_variant.available -%}
                {{ 'products.in_stock' | t }}
              {%- else -%}
                {{ 'products.sold_out' | t }}
              {%- endif -%}
            </span>
          </div>
        </div>

        <div class="pp__price-block">
          <div class="pp__price-row">
            <span class="pp__price" data-price>{{ current_variant.price | money }}</span>
            {%- if on_sale -%}
              <s class="pp__compare" data-compare>{{ compare | money }}</s>
              <span class="pp__discount" data-discount>{{ discount_percent }}% OFF</span>
            {%- else -%}
              <s class="pp__compare" data-compare hidden></s>
              <span class="pp__discount" data-discount hidden></span>
            {%- endif -%}
          </div>
          {%- if on_sale and save_amount > 0 -%}
            {%- assign save_money = save_amount | money -%}
            <p class="pp__save" data-save>{{ 'products.save_amount' | t: amount: save_money }}</p>
          {%- else -%}
            <p class="pp__save" data-save hidden></p>
          {%- endif -%}
          {%- if section.settings.installments_text != blank -%}
            <p class="pp__installments">{{ section.settings.installments_text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if short_desc != blank -%}
          <p class="pp__excerpt">{{ short_desc | escape }}</p>
        {%- endif -%}

        <div class="pp__trust-marquee" aria-label="{{ 'products.trust_highlights' | t }}">
          <div class="pp__trust-track">
            {%- for copy in (1..2) -%}
              <div class="pp__trust-group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
                {%- for repeat in (1..2) -%}
                  {%- for block in feature_blocks -%}
                    {%- if block.settings.text != blank -%}
                      <span class="pp__trust-chip">
                        <span class="pp__trust-chip-mark" aria-hidden="true">✓</span>
                        <span>{{ block.settings.text | escape }}</span>
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                  <span class="pp__trust-chip">
                    <span class="pp__trust-chip-mark" aria-hidden="true">✓</span>
                    <span>{{ section.settings.shipping_text | default: 'Fast nationwide delivery' | escape }}</span>
                  </span>
                  <span class="pp__trust-chip">
                    <span class="pp__trust-chip-mark" aria-hidden="true">✓</span>
                    <span>{{ 'products.delivery.cod_title' | t }}</span>
                  </span>
                  <span class="pp__trust-chip">
                    <span class="pp__trust-chip-mark" aria-hidden="true">✓</span>
                    <span>{{ section.settings.returns_text | default: '14-day easy returns' | escape }}</span>
                  </span>
                  <span class="pp__trust-chip">
                    <span class="pp__trust-chip-mark" aria-hidden="true">✓</span>
                    <span>{{ 'products.delivery.warranty_title' | t }}</span>
                  </span>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- form 'product', product, class: 'pp__form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          {%- if has_variants -%}
            <div class="pp__options" data-options>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_index = option.position | minus: 1
                  assign option_name_down = option.name | downcase
                  assign is_color = false
                  if option_name_down contains 'color' or option_name_down contains 'colour'
                    assign is_color = true
                  endif
                  assign selected_value = current_variant.options[option_index]
                -%}
                <fieldset
                  class="pp__option{% if is_color %} pp__option--color{% endif %}"
                  data-option-index="{{ option_index }}"
                >
                  <legend class="pp__option-label">
                    {{ option.name | escape }}
                    <span data-selected-label>{{ selected_value | escape }}</span>
                  </legend>
                  <div class="pp__option-values">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign is_selected = false
                        if selected_value == value
                          assign is_selected = true
                        endif
                        assign swatch_style = blank
                        if is_color
                          assign value_handle = value | handleize
                          assign matched_variant = blank
                          for variant in product.variants
                            if variant.options[option_index] == value and variant.featured_media != blank
                              assign matched_variant = variant
                              break
                            endif
                          endfor
                          if matched_variant != blank
                            assign swatch_img = matched_variant.featured_media.preview_image | image_url: width: 96
                            assign swatch_style = 'background-image:url(' | append: swatch_img | append: ');'
                          else
                            assign swatch_style = 'background-color:' | append: value_handle | append: ';'
                          endif
                        endif
                      -%}
                      <button
                        type="button"
                        class="pp__choice{% if is_color %} pp__choice--swatch{% else %} pp__choice--size{% endif %}{% if is_selected %} is-selected{% endif %}"
                        data-option-value="{{ value | escape }}"
                        aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
                        title="{{ value | escape }}"
                        {% if is_color and swatch_style != blank %}style="{{ swatch_style }}"{% endif %}
                      >
                        {%- if is_color -%}
                          <span class="pp__choice-tick" aria-hidden="true">✓</span>
                          <span class="visually-hidden">{{ value | escape }}</span>
                        {%- else -%}
                          {{ value | escape }}
                        {%- endif -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="pp__qty-row">
            <span class="pp__qty-label">{{ 'products.quantity' | t }}</span>
            <div class="pp__qty" data-qty>
              <button type="button" class="pp__qty-btn" data-qty-minus aria-label="{{ 'accessibility.decrease_quantity' | t }}">−</button>
              <input
                class="pp__qty-input"
                type="number"
                name="quantity"
                min="1"
                value="1"
                data-qty-input
                aria-label="{{ 'products.quantity' | t }}"
              >
              <button type="button" class="pp__qty-btn" data-qty-plus aria-label="{{ 'accessibility.increase_quantity' | t }}">+</button>
            </div>
          </div>

          <div class="pp__actions" data-actions-anchor>
            <div class="pp__actions-row">
              <button
                type="submit"
                name="add"
                class="pp__atc"
                data-add-to-cart
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-atc-label>
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>

              <button
                type="button"
                class="pp__wish"
                data-wishlist-toggle
                aria-pressed="false"
                aria-label="{{ 'products.add_to_wishlist' | t }}"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path d="M12 21s-6.7-4.35-9.33-8.22C.8 10.2 1.2 6.9 3.7 5.3 6 3.85 8.7 4.6 12 7.4c3.3-2.8 6-3.55 8.3-2.1 2.5 1.6 2.9 4.9 1.03 7.48C18.7 16.65 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </button>
            </div>

            {%- if section.settings.show_buy_button -%}
              <button
                type="button"
                class="pp__buy"
                data-buy-now
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {{ 'products.buy_now' | t }}
              </button>
            {%- endif -%}

            {%- if whatsapp_href != blank -%}
              <a class="pp__wa" href="{{ whatsapp_href }}" target="_blank" rel="noopener" data-whatsapp>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.84c0 1.98.58 3.82 1.58 5.38L2 22l4.94-1.63a9.86 9.86 0 0 0 5.1 1.4h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2Zm5.79 13.98c-.25.7-1.45 1.28-2.01 1.36-.51.07-1.16.1-1.87-.12-.43-.13-.98-.32-1.68-.62-2.96-1.28-4.89-4.26-5.04-4.46-.14-.2-1.18-1.57-1.18-3 0-1.42.74-2.12.99-2.41.26-.29.56-.36.75-.36h.54c.17 0 .41-.07.64.49.25.58.84 2.04.91 2.19.08.15.12.32.02.51-.1.2-.15.32-.29.49-.14.17-.3.38-.43.51-.14.14-.29.29-.12.56.17.28.74 1.22 1.59 1.98 1.1.97 2.02 1.27 2.3 1.41.29.14.45.12.62-.07.17-.2.72-.84.91-1.13.2-.29.39-.24.66-.14.26.1 1.68.79 1.97.94.29.14.48.22.55.34.08.13.08.74-.17 1.44Z"/></svg>
                {{ 'products.order_via_whatsapp' | t }}
              </a>
            {%- endif -%}

            <p class="pp__reassure">{{ 'products.trust.secure' | t }} · {{ 'products.trust.save_return' | t }} · {{ 'products.trust.cod' | t }}</p>
          </div>
        {%- endform -%}

        {%- if section.settings.show_payment_icons -%}
          <div class="pp__payments">
            <p>{{ 'products.secure_payments' | t }}</p>
            <div class="pp__payment-icons">
              {{ 'visa' | payment_type_svg_tag }}
              {{ 'master' | payment_type_svg_tag }}
              {{ 'apple_pay' | payment_type_svg_tag }}
              {{ 'google_pay' | payment_type_svg_tag }}
            </div>
          </div>
        {%- endif -%}

        <div class="pp__accordion" data-accordion>
          {%- if accordion_blocks.size > 0 -%}
            {%- for block in accordion_blocks -%}
              <details class="pp__acc-item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
                <summary>{{ block.settings.title | default: 'Details' | escape }}</summary>
                <div class="pp__acc-body rte">
                  {%- if block.settings.content != blank -%}
                    {{ block.settings.content }}
                  {%- elsif forloop.first and product.description != blank -%}
                    {{ product.description }}
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          {%- else -%}
            <details class="pp__acc-item" open>
              <summary>{{ 'products.tabs.details' | t }}</summary>
              <div class="pp__acc-body rte">
                {%- if product.description != blank -%}
                  {{ product.description }}
                {%- else -%}
                  <p>{{ 'products.no_description' | t }}</p>
                {%- endif -%}
              </div>
            </details>
            <details class="pp__acc-item">
              <summary>{{ 'products.delivery.shipping_title' | t }}</summary>
              <div class="pp__acc-body"><p>{{ section.settings.shipping_text | default: 'Fast nationwide delivery' | escape }}</p></div>
            </details>
            <details class="pp__acc-item">
              <summary>{{ 'products.delivery.warranty_title' | t }}</summary>
              <div class="pp__acc-body"><p>{{ section.settings.warranty_text | default: 'Official quality guarantee' | escape }}</p></div>
            </details>
            <details class="pp__acc-item">
              <summary>{{ 'products.delivery.returns_title' | t }}</summary>
              <div class="pp__acc-body"><p>{{ section.settings.returns_text | default: '14-day easy returns' | escape }}</p></div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id | json }},
      "options": {{ product.options | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "option1": {{ variant.option1 | json }},
            "option2": {{ variant.option2 | json }},
            "option3": {{ variant.option3 | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <div class="pp__sticky" data-sticky-bar hidden>
    <div class="pp__sticky-inner">
      <div class="pp__sticky-meta">
        <p class="pp__sticky-title">{{ product.title | escape | truncate: 36 }}</p>
        <div class="pp__sticky-price-row">
          <span data-sticky-price>{{ current_variant.price | money }}</span>
          {%- if on_sale -%}
            <s data-sticky-compare>{{ compare | money }}</s>
          {%- else -%}
            <s data-sticky-compare hidden></s>
          {%- endif -%}
        </div>
      </div>
      <div class="pp__sticky-actions">
        <button type="button" class="pp__sticky-atc" data-sticky-atc {% unless current_variant.available %}disabled{% endunless %}>
          <span data-sticky-atc-label>
            {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
          </span>
        </button>
        {%- if section.settings.show_buy_button -%}
          <button type="button" class="pp__sticky-buy" data-sticky-buy {% unless current_variant.available %}disabled{% endunless %}>
            {{ 'products.buy_now' | t }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-gallery-json>
    [
      {%- assign gallery_first = true -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {%- unless gallery_first -%},{%- endunless -%}
          {
            "id": {{ media.id | json }},
            "src": {{ media.preview_image | image_url: width: 2400 | json }},
            "alt": {{ media.alt | default: product.title | json }}
          }
          {%- assign gallery_first = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  <div
    class="pp__lightbox"
    data-lightbox
    data-count-template="{{ 'accessibility.image_of' | t: index: '__INDEX__', count: '__COUNT__' }}"
    hidden
  >
    <div class="pp__lightbox-overlay" data-lightbox-close></div>
    <button
      type="button"
      class="pp__lightbox-close"
      data-lightbox-close
      aria-label="{{ 'accessibility.close_gallery' | t }}"
    >
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
    <button
      type="button"
      class="pp__lightbox-nav pp__lightbox-nav--prev"
      data-lightbox-prev
      aria-label="{{ 'accessibility.previous_slide' | t }}"
    >
      ‹
    </button>
    <div
      class="pp__lightbox-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'accessibility.product_images' | t }}"
      tabindex="-1"
      data-lightbox-dialog
    >
      <img class="pp__lightbox-image" data-lightbox-image alt="">
      <p class="pp__lightbox-count" data-lightbox-count></p>
    </div>
    <button
      type="button"
      class="pp__lightbox-nav pp__lightbox-nav--next"
      data-lightbox-next
      aria-label="{{ 'accessibility.next_slide' | t }}"
    >
      ›
    </button>
  </div>
</tah-product-page>

{% stylesheet %}
  .pp {
    --pp-ink: var(--color-text);
    --pp-mute: var(--color-text-muted);
    --pp-line: var(--color-border);
    --pp-soft: var(--color-surface);
    --pp-black: var(--color-button);
    --pp-radius: 20px;
    --pp-ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--pp-bg, var(--color-background));
    color: var(--pp-ink);
  }

  .pp__shell {
    width: min(1180px, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: var(--pp-pad-t, 32px) var(--pp-pad-b, 80px);
  }

  .pp__grid {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }

  /* Gallery */
  .pp__gallery {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .pp__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--pp-radius);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-accent) 10%, var(--pp-line));
    box-shadow: 0 18px 40px color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .pp__media-host {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }

  .pp__media-host[data-skeleton]::before {
    border-radius: inherit;
  }

  .pp__zoom {
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: zoom-in;
    display: grid;
    place-items: center;
  }

  .pp__main-img,
  .pp__placeholder {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    transition: transform 420ms var(--pp-ease), opacity 280ms ease;
  }

  .pp__zoom:hover .pp__main-img {
    transform: scale(1.06);
  }

  .pp__stage.is-video .pp__zoom {
    cursor: default;
  }

  .pp__main-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    background: var(--color-button);
  }

  .pp__main-video--external,
  .pp__main-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .pp__media-host > .pp__main-video,
  .pp__media-host > video,
  .pp__media-host > iframe {
    width: 100%;
    height: 100%;
  }

  .pp__badge-sale,
  .pp__badge-stock {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }

  .pp__badge-sale {
    top: 1rem;
    left: 1rem;
    background: var(--pp-accent, var(--color-accent));
    color: var(--color-button-text);
  }

  .pp__badge-stock {
    top: 1rem;
    right: 1rem;
    background: var(--color-background);
    color: var(--color-error);
    border: 1px solid var(--pp-line);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-heading) 6%, transparent);
  }

  .pp__thumbs-wrap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.45rem;
    align-items: center;
  }

  .pp__thumbs {
    display: flex;
    gap: 0.55rem;
    margin: 0;
    padding: 0.15rem 0;
    list-style: none;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .pp__thumbs::-webkit-scrollbar { display: none; }

  .pp__thumb {
    appearance: none;
    position: relative;
    flex: 0 0 auto;
    width: 4.5rem;
    height: 5.5rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    cursor: pointer;
    transition: border-color 160ms ease, transform 160ms var(--pp-ease), box-shadow 160ms ease;
  }

  .pp__thumb:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--color-heading) 8%, transparent);
  }

  .pp__thumb.is-active {
    border-color: var(--pp-accent, var(--color-accent));
  }

  .pp__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .pp__thumb--video .pp__thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-button-text);
    background: color-mix(in srgb, var(--color-heading) 28%, transparent);
    pointer-events: none;
  }

  .pp__thumb-nav {
    appearance: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--pp-line);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--pp-ink);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Buy box */
  .pp__buybox {
    display: grid;
    gap: 0.95rem;
    align-content: start;
    min-width: 0;
    padding: 0.15rem 0 0;
  }

  .pp__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--pp-mute);
  }

  .pp__crumb a {
    color: inherit;
    text-decoration: none;
  }

  .pp__crumb a:hover {
    color: var(--color-accent);
  }

  .pp__crumb span[aria-current='page'] {
    color: var(--color-heading);
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pp__brand {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .pp__title {
    margin: 0;
    font-size: clamp(1.55rem, 2.4vw, 2.05rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.18;
    color: var(--color-heading);
  }

  .pp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
  }

  .pp__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
  }

  .pp__stars {
    color: var(--color-border);
    letter-spacing: 0.05em;
  }

  .pp__stars .is-on { color: var(--color-star); }

  .pp__reviews-count {
    color: var(--pp-mute);
  }

  .pp__verified {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, #fff);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .pp__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-success);
  }

  .pp__availability.is-out { color: var(--color-error); }

  .pp__avail-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: currentColor;
  }

  .pp__price-block { display: grid; gap: 0.35rem; }

  .pp__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem 0.7rem;
  }

  .pp__price {
    font-size: clamp(1.7rem, 2.8vw, 2.15rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--color-accent);
    line-height: 1;
  }

  .pp__compare {
    font-size: 1.05rem;
    color: var(--pp-mute);
  }

  .pp__discount {
    display: inline-flex;
    align-items: center;
    min-height: 1.65rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--pp-accent, var(--color-accent));
    color: var(--color-button-text);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .pp__discount[hidden],
  .pp__compare[hidden],
  .pp__save[hidden],
  .pp__badge-sale[hidden] {
    display: none !important;
  }

  .pp__save {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-success);
  }

  .pp__installments {
    margin: 0;
    font-size: 0.875rem;
    color: var(--pp-mute);
  }

  .pp__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pp__proof-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--color-background);
    border: 1px solid var(--pp-line);
    font-size: 0.75rem;
    font-weight: 650;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-heading) 4%, transparent);
  }

  .pp__proof-pill--accent {
    background: rgb(34 197 94 / 0.1);
    border-color: transparent;
    color: var(--color-success);
  }

  .pp__excerpt {
    margin: 0;
    max-width: 36rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--pp-mute);
  }

  .pp__trust-marquee {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .pp__trust-track {
    display: flex;
    width: max-content;
    align-items: center;
    will-change: transform;
    animation: pp-trust-scroll 48s linear infinite;
  }

  .pp__trust-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.65rem;
    padding-inline-end: 0.65rem;
  }

  .pp__trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    padding: 0.48rem 0.85rem;
    white-space: nowrap;
    background: color-mix(in srgb, var(--color-surface) 86%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, var(--pp-line));
    border-radius: 999px;
    box-shadow: 0 8px 18px color-mix(in srgb, var(--color-heading) 5%, transparent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-heading);
  }

  .pp__trust-chip-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--color-button);
    color: var(--color-button-text);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
  }

  .pp__trust-marquee:hover .pp__trust-track {
    animation-play-state: paused;
  }

  @keyframes pp-trust-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .pp__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0.15rem 0 0;
    padding: 0.15rem 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 10%, var(--pp-line));
  }

  .pp__feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.15rem;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--color-heading);
  }

  .pp__feature-icon {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, #fff);
    color: var(--color-accent);
    flex: 0 0 auto;
  }

  .pp__feature-icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .pp__delivery-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, #fff);
    color: var(--color-accent);
    flex: 0 0 auto;
  }

  .pp__delivery-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .pp__trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pp__trust-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.85rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-background) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-background) 70%, transparent);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-heading) 5%, transparent);
    backdrop-filter: blur(10px);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pp__trust-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    background: var(--pp-black);
    color: var(--color-button-text);
    font-size: 0.65rem;
    flex: 0 0 auto;
  }

  .pp__form { display: grid; gap: 1.15rem; }

  .pp__options { display: grid; gap: 1rem; }

  .pp__option { margin: 0; padding: 0; border: 0; }

  .pp__option-label {
    display: flex;
    gap: 0.4rem;
    margin: 0 0 0.6rem;
    padding: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .pp__option-label span {
    font-weight: 500;
    color: var(--pp-mute);
  }

  .pp__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .pp__choice {
    appearance: none;
    font: inherit;
    cursor: pointer;
    transition: transform 150ms var(--pp-ease), box-shadow 150ms ease, border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .pp__choice--swatch {
    position: relative;
    width: 2.85rem;
    height: 2.85rem;
    border: 2px solid var(--color-background);
    border-radius: 999px;
    background-size: cover;
    background-position: center;
    background-color: var(--color-border);
    box-shadow: 0 0 0 1px var(--color-border), 0 6px 14px color-mix(in srgb, var(--color-heading) 8%, transparent);
  }

  .pp__choice--swatch .pp__choice-tick {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-button-text);
    font-size: 0.85rem;
    font-weight: 800;
    opacity: 0;
    text-shadow: 0 1px 2px color-mix(in srgb, var(--color-heading) 45%, transparent);
    transition: opacity 150ms ease;
  }

  .pp__choice--swatch.is-selected {
    box-shadow: 0 0 0 2px var(--pp-accent, var(--color-accent)), 0 8px 18px color-mix(in srgb, var(--color-heading) 12%, transparent);
  }

  .pp__choice--swatch.is-selected .pp__choice-tick { opacity: 1; }

  .pp__choice--size {
    min-width: 3.1rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--pp-line);
    border-radius: 14px;
    background: var(--color-background);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .pp__choice--size.is-selected {
    background: var(--color-accent);
    color: var(--color-button-text);
    border-color: var(--color-accent);
  }

  .pp__choice:hover { transform: translateY(-1px); }
  .pp__choice.is-soldout { opacity: 0.35; text-decoration: line-through; }

  .pp__qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pp__qty-label { font-size: 0.9rem; font-weight: 700; }

  .pp__qty {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--color-background);
    border: 1px solid var(--pp-line);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--color-heading) 5%, transparent);
  }

  .pp__qty-btn {
    appearance: none;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--pp-soft);
    color: var(--pp-black);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .pp__qty-input {
    width: 2.75rem;
    border: 0;
    background: transparent;
    text-align: center;
    font: inherit;
    font-weight: 750;
    -moz-appearance: textfield;
  }

  .pp__qty-input::-webkit-outer-spin-button,
  .pp__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pp__actions { display: grid; gap: 0.7rem; }

  .pp__actions-row {
    display: grid;
    grid-template-columns: 1fr 3.75rem;
    gap: 0.7rem;
    align-items: stretch;
  }

  .pp__wish {
    appearance: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    min-height: 3.75rem;
    padding: 0;
    border: 1px solid var(--pp-line);
    border-radius: 16px;
    background: var(--color-background);
    color: var(--color-accent);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms var(--pp-ease);
  }

  .pp__wish.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-button-text);
  }

  .pp__wish.is-active svg path {
    fill: currentColor;
    stroke: none;
  }

  .pp__wish:hover,
  .pp__wish:focus-visible {
    transform: translateY(-1px);
    border-color: var(--color-accent);
  }

  .pp__atc,
  .pp__buy,
  .pp__wa {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 3.75rem;
    padding: 0 1.25rem;
    border-radius: 16px;
    font: inherit;
    font-size: 1rem;
    font-weight: 750;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms var(--pp-ease), box-shadow 160ms ease, background-color 160ms ease, border-color 160ms ease, color 160ms ease, opacity 160ms ease;
  }

  .pp__atc {
    border: 0;
    background: var(--color-button);
    color: var(--color-button-text);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--color-accent) 24%, transparent);
  }

  .pp__atc:hover,
  .pp__atc:focus-visible {
    background: var(--pp-btn-hover, var(--color-button-hover));
    transform: translateY(-2px);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--color-accent) 28%, transparent);
  }

  .pp__buy {
    border: 1.5px solid var(--color-heading);
    background: transparent;
    color: var(--color-heading);
  }

  .pp__buy:hover,
  .pp__buy:focus-visible {
    background: var(--color-heading);
    color: var(--color-button-text);
    transform: translateY(-1px);
  }

  .pp__wa {
    border: 1px solid color-mix(in srgb, #25d366 40%, var(--pp-line));
    background: color-mix(in srgb, #25d366 8%, var(--color-background));
    color: #128c4a;
    box-shadow: none;
    min-height: 3.15rem;
    font-size: 0.92rem;
  }

  .pp__wa:hover,
  .pp__wa:focus-visible {
    transform: translateY(-1px);
    background: #25d366;
    color: #fff;
    border-color: #25d366;
  }

  .pp__reassure {
    margin: 0.15rem 0 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--pp-mute);
  }

  .pp__atc:disabled,
  .pp__buy:disabled,
  .pp__atc.is-loading,
  .pp__buy.is-loading,
  .pp__sticky-atc:disabled,
  .pp__sticky-buy:disabled,
  .pp__sticky-atc.is-loading,
  .pp__sticky-buy.is-loading {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .pp__delivery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pp__delivery li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.75rem 0.15rem;
  }

  .pp__payments {
